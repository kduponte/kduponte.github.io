---
// A full-width pull quote band: the line in big serif italic on grey, with an echo of the page's
// season ripple running in from the left.
// Pull quotes repeat words already on the page, so `echo` (the default) hides it from screen
// readers to avoid reading the same sentence twice.
import Ripples from "../Ripples.astro";
import { seedFrom } from "../../lib/patterns/ripples";

interface Props {
	cite?: string;
	echo?: boolean;
	class?: string;
}

const { cite, echo = true, class: className = "" } = Astro.props;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
---

<figure
	class:list={["relative overflow-hidden border-y-[3px] border-black bg-grey text-ink", className]}
	aria-hidden={echo ? "true" : undefined}
>
	<Ripples form="echo" seed={seedFrom(slug, 131)} cx={-10} cy={500} class="text-ring-paper" />
	<div class="halftone absolute inset-0 opacity-20" aria-hidden="true"></div>
	<div class="relative mx-auto max-w-5xl px-6 py-16 md:px-12 md:py-24">
		<blockquote class="text-[clamp(2.2rem,5.4vw,4.6rem)] leading-[1.02]" style="font-family: var(--font-serif-accent); font-style: italic">
			<span class="font-anton not-italic text-paper" style="-webkit-text-stroke: 2px var(--color-black)">“</span><slot /><span class="font-anton not-italic text-paper" style="-webkit-text-stroke: 2px var(--color-black)">”</span>
		</blockquote>
		{cite && <figcaption class="font-mono mt-6 text-[11px] uppercase">{cite}</figcaption>}
	</div>
</figure>
