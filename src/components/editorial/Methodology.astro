---
// Methods as magazine rows: the heading in big type on the left, the short version in bold and the
// detail on the right, with heavy rules between, instead of a column of small grey paragraphs.
interface Section {
	heading: string;
	body: string;
	tldr?: string;
}

interface Props {
	title?: string;
	intro?: string;
	sections: Section[];
	id?: string;
}

const { title = "Methodology", intro, sections, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
	<div class="font-mono flex items-center gap-3 border-b-[3px] border-black pb-2 text-[11px] uppercase">
		<span class="bg-black px-2 py-0.5 text-spot">How it was done</span>
	</div>
	<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
		<h2 class="font-anton text-6xl leading-[0.9] md:col-span-5 md:text-7xl">{title}</h2>
		{intro && <p class="text-lg font-semibold leading-snug md:col-span-7 md:text-xl">{intro}</p>}
	</div>
	<div class="mt-12">
		{
			sections.map((section, i) => (
				<div class="grid grid-cols-1 gap-4 border-t-[3px] border-black py-8 md:grid-cols-12 md:gap-10">
					<div class="flex items-start gap-3 md:col-span-4">
						<span class="font-mono mt-1 bg-black px-2 py-0.5 text-[10px] text-spot">{String(i + 1).padStart(2, "0")}</span>
						<h3 class="font-anton text-2xl uppercase leading-[1] md:text-3xl">{section.heading}</h3>
					</div>
					<div class="md:col-span-8">
						{section.tldr && <p class="text-lg font-bold leading-snug">{section.tldr}</p>}
						<p class:list={["text-[16px] font-medium leading-relaxed", section.tldr && "mt-3"]}>{section.body}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
