---
// Markup + mount points only; all behavior lives in src/scripts/peeking-problem/peeking-study-chart.ts.
---

<section id="peeking-study" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">What peeking actually costs you</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Simulate hundreds of independent experiments where there is truly no difference between A and B, and count how
		often each method would have declared a winner: checking once at a fixed end date, versus checking every single
		day and stopping the moment either method looked convincing.
	</p>

	<form id="pp-study-controls" class="mt-8 grid grid-cols-1 gap-4 border border-line p-6 sm:grid-cols-3">
		<label class="col-span-2 flex flex-col gap-1 text-sm">
			<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">Prior strength (Bayesian rule): weak &rarr; skeptical</span>
			<input id="pp-study-prior-strength" type="range" min="0" max="1" step="0.01" class="accent-accent-blue w-full" />
		</label>
		<div class="flex items-end">
			<button
				type="button"
				id="pp-study-run-button"
				class="w-full border border-ink bg-ink px-5 py-2.5 font-mono text-xs uppercase tracking-wide text-paper transition-colors hover:border-accent-blue hover:bg-accent-blue"
			>
				Run peeking study
			</button>
		</div>
	</form>

	<div id="pp-peeking-study" class="mt-6">
		<div data-vg-summary class="border border-line p-4 font-mono text-sm"></div>
		<div class="mt-4 flex justify-end">
			<button type="button" data-vg-table-toggle class="font-mono text-xs uppercase tracking-wide text-accent-blue" aria-pressed="false">
				View as table
			</button>
		</div>
		<div data-vg-chart class="mt-2 grid grid-cols-1 gap-8 overflow-x-auto md:grid-cols-2"></div>
		<div data-vg-table class="mt-2 overflow-x-auto"></div>
	</div>

	<script src="../../../scripts/peeking-problem/peeking-study-chart.ts"></script>
</section>
