---
interface Props {
	title?: string;
	items: string[];
}

const { title = "Limitations", items } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">{title}</h2>
	<ul class="mt-8 max-w-[65ch] space-y-3">
		{
			items.map((item) => (
				<li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
					<span class="font-mono text-black" aria-hidden="true">
						—
					</span>
					<span>{item}</span>
				</li>
			))
		}
	</ul>
</section>
