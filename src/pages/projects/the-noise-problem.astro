---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/projects/the-noise-problem/HeroSection.astro";
import FoundationsSection from "../../components/projects/the-noise-problem/FoundationsSection.astro";
import CoreIdeaSection from "../../components/projects/the-noise-problem/CoreIdeaSection.astro";
import LiveExperimentSection from "../../components/projects/the-noise-problem/LiveExperimentSection.astro";
import StudySection from "../../components/projects/the-noise-problem/StudySection.astro";
import OutlierHandlingSection from "../../components/projects/the-noise-problem/OutlierHandlingSection.astro";
import OutlierStudySection from "../../components/projects/the-noise-problem/OutlierStudySection.astro";
import TechniqueSurveySection from "../../components/projects/the-noise-problem/TechniqueSurveySection.astro";
import WhenNotCupedSection from "../../components/projects/the-noise-problem/WhenNotCupedSection.astro";
import KeyFindings from "../../components/editorial/KeyFindings.astro";
import Methodology from "../../components/editorial/Methodology.astro";
import Limitations from "../../components/editorial/Limitations.astro";
import NextSteps from "../../components/editorial/NextSteps.astro";
import outlierFindings from "../../../public/data/the-noise-problem/outlier-findings.json";

// Every outlier-handling figure below is read from outlier-findings.json, regenerated by
// scripts/the-noise-problem/build-outlier-findings.ts from a fixed seed and configuration, rather
// than typed in from a run nobody can repeat.
const sc = outlierFindings.scenarios;
const trials = outlierFindings.trials.toLocaleString();
const p1 = (x: number | null) => `${((x ?? 0) * 100).toFixed(1)}%`;
const p0 = (x: number | null) => `${Math.round((x ?? 0) * 100)}%`;
const x2 = (x: number | null) => `${(x ?? 0).toFixed(2)}×`;
const n99 = sc.null_99.methods;
const n90 = sc.null_90.methods;
const n5x = sc.null_99_5x_traffic.methods;
const uni = sc.uniform_99.methods;
const tail = sc.tail_99.methods;
const ciText = (m: { ci_low: number | null; ci_high: number | null }) => `${p1(m.ci_low)} to ${p1(m.ci_high)}`;
const bar = (m: { final_day_detection_rate: number | null }) => Number(((m.final_day_detection_rate ?? 0) * 100).toFixed(1));
---

<BaseLayout
	title="The Noise Problem"
	description="Most of the variance in your metric has nothing to do with your treatment. Live simulations of CUPED and outlier handling, the trade-offs each one carries, and when neither is the right tool."
>
	<HeroSection />
	<FoundationsSection />
	<CoreIdeaSection />
	<LiveExperimentSection />
	<StudySection />
	<OutlierHandlingSection />
	<OutlierStudySection />
	<TechniqueSurveySection />
	<WhenNotCupedSection />

	<KeyFindings
		lede="Short version: subtracting each visitor's own predictable, pre-experiment baseline shrinks a metric's variance by exactly (1 − correlation²), doesn't touch the false-positive rate at all, and lets a real effect become visible in meaningfully fewer days, the benefit scaling directly with how predictive the pre-period data actually is."
		groups={[
			{
				heading: "The mechanic",
				description: "Does this actually behave the way the theory says, and does it cheat anywhere?",
				findings: [
					{
						label: "CUPED doesn't inflate false positives",
						bars: [
							{ label: "Raw", value: 4.3 },
							{ label: "CUPED-adjusted", value: 4.85 },
						],
						detail:
							"Across 2,000 simulated null-true experiments (no real difference between A and B), the raw metric's final-day false-positive rate was 4.3%, the CUPED-adjusted metric's was 4.85%, both close to the textbook 5%. Subtracting the same rule from every visitor, regardless of arm, can't manufacture a difference that wasn't there.",
					},
					{
						label: "Variance reduction follows one exact formula, not a rule of thumb",
						detail:
							"Directly from Var(Y_cuped) = Var(Y)·(1 − correlation²): at a pre/post correlation of 0.3, only 9% of variance is removed. At 0.5, 25%. At 0.7, 49%. At 0.85, 72.2%. At 0.9, 81%. The formula isn't approximate, it's exact, confirmed here by direct Monte Carlo simulation, not just asserted (see Methodology).",
					},
				],
			},
			{
				heading: "How much faster, really",
				description: "The same real effect, the same traffic and time budget, measured with and without the adjustment.",
				findings: [
					{
						label: "At a strong correlation, the practical difference is dramatic",
						bars: [
							{ label: "Raw", value: 68.9 },
							{ label: "CUPED-adjusted", value: 99.5 },
						],
						detail:
							"At a 0.85 correlation, 30 visitors/day/arm, and a modest genuine lift, checking once at a fixed day 10: the raw metric detects it 68.9% of the time, the CUPED-adjusted metric 99.5% of the time. Same visitors, same treatment, same single pre-planned look, a very different chance of actually seeing the effect that's really there.",
					},
					{
						label: "The benefit scales with correlation, it isn't a fixed bonus",
						bars: [
							{ label: "ρ=0.3", value: 74.6 },
							{ label: "ρ=0.6", value: 86.8 },
							{ label: "ρ=0.85", value: 99.5 },
						],
						detail:
							"Same day-10 fixed-look comparison, varying only the pre/post correlation: at ρ=0.3 CUPED barely helps (69.9% raw vs. 74.6% adjusted, both similar). At ρ=0.6 the gap opens up (69.5% vs. 86.8%). At ρ=0.85 it's dramatic (68.9% vs. 99.5%). A weak covariate is nearly free but nearly useless; a strong one is transformative. There's no such thing as \"turning CUPED on\", only how predictive the pre-period data actually is.",
					},
					{
						label: "Given enough time, both get there, CUPED just gets there sooner",
						bars: [
							{ label: "Raw median day", value: 5 },
							{ label: "CUPED median day", value: 2 },
						],
						detail:
							"Extend the window to 30 days at the same 0.85 correlation: both methods eventually detect the real effect in almost every trial (99.0% raw, 100% CUPED). The difference shows up in speed, not in whether the effect is eventually found: the median day of first detection is day 5 for the raw metric, day 2 for the CUPED-adjusted one.",
					},
				],
			},
			{
				heading: "Outliers cut both ways",
				description: "Capping or trimming extreme values helps or hurts depending on where the effect lives, and one common way of setting the cap breaks the test.",
				findings: [
					{
						label: "Capping each arm at its own percentile breaks the false-positive rate",
						bars: [
							{ label: "Raw", value: bar(n99.raw), unit: "%" },
							{ label: "Pooled cap", value: bar(n99.pooled), unit: "%" },
							{ label: "Stratified cap", value: bar(n99.stratified), unit: "%" },
						],
						detail: `With no real difference, across ${trials} simulated experiments capped at the 99th percentile, raw testing raised a false alarm ${p1(n99.raw.final_day_detection_rate)} of the time and one cap shared by both arms (pooled) ${p1(n99.pooled.final_day_detection_rate)}, both near the nominal 5%. Capping each arm at its own percentile (stratified) did so ${p1(n99.stratified.final_day_detection_rate)} of the time (95% interval ${ciText(n99.stratified)}). At the 90th percentile it reached ${p1(n90.stratified.final_day_detection_rate)}.`,
					},
					{
						label: "The cause, measured rather than guessed",
						detail: `A cap estimated from one arm's data moves with that arm's luck, and the test's standard error ignores it. Stratified's estimate varied ${x2(n99.stratified.se_calibration)} as much as its own error bars said it would, which on its own predicts a false-positive rate of ${p1(n99.stratified.implied_false_positive_rate)}; the simulation produced ${p1(n99.stratified.final_day_detection_rate)}. At the 90th percentile: ${x2(n90.stratified.se_calibration)}, predicting ${p1(n90.stratified.implied_false_positive_rate)} against ${p1(n90.stratified.final_day_detection_rate)} observed. A shared cap moves both arms together, so its noise cancels (${x2(n99.pooled.se_calibration)}). Five times the traffic does not help: ${p1(n5x.stratified.final_day_detection_rate)}.`,
					},
					{
						label: "Capping pays off only when the effect is spread out",
						bars: [
							{ label: "Raw", value: Number(((tail.raw.lift_capture ?? 0) * 100).toFixed(0)), unit: "%" },
							{ label: "Pooled cap", value: Number(((tail.pooled.lift_capture ?? 0) * 100).toFixed(0)), unit: "%" },
							{ label: "Stratified cap", value: Number(((tail.stratified.lift_capture ?? 0) * 100).toFixed(0)), unit: "%" },
						],
						detail: `With a 30% lift spread evenly across spenders, a pooled cap caught it in ${p1(uni.pooled.final_day_detection_rate)} of experiments against ${p1(uni.raw.final_day_detection_rate)} raw, even though its estimate kept only ${p0(uni.pooled.lift_capture)} of the true lift: the variance fell faster than the effect did. When the same total lift came from the top 5% of spenders, the pooled cap caught it ${p1(tail.pooled.final_day_detection_rate)} of the time against ${p1(tail.raw.final_day_detection_rate)} raw, and kept only ${p0(tail.pooled.lift_capture)} of it (the bars). Stratified looks better on both counts, but part of that is the same false-positive inflation.`,
					},
				],
			},
		]}
	/>

	<Methodology
		id="methodology"
		intro="This section is the full construction and citations behind everything above. If you just want the intuition and the two analogies, see Why does removing noise help? earlier on this page, each section below also opens with a one-line plain-English summary."
		sections={[
			{
				heading: "The two engines, run in parallel",
				tldr: "Every simulated day, the exact same accumulated data gets tested twice: once as-is, once with each visitor's pre-period value subtracted out.",
				body: "Each simulated day, every visitor is generated as a correlated (pre-period, post-period) pair, the post-period value is the only one treatment ever touches. A two-sample z-test on means (the same twoSampleZTestOnMeans used by the revenue-metric mode in The Peeking Problem) runs on the raw post-period values, and separately on the CUPED-adjusted values, both reading off the identical underlying simulated visitors, so any difference between the two lines is attributable to the adjustment alone, not to different data.",
			},
			{
				heading: "How theta gets estimated",
				tldr: "The one number the adjustment needs, theta, is re-estimated each day from all the data collected so far, pooled across both arms.",
				body: "θ = Cov(X, Y) / Var(X) is recomputed each day from every visitor observed so far in both arms combined, on the reasoning that the pre/post relationship is a property of the metric itself, not something the treatment is assumed to change. A production implementation more commonly fits θ once, from a genuinely separate historical pre-experiment window, rather than re-estimating it in-experiment as done here, a deliberate simplification noted again in Limitations.",
			},
			{
				heading: "Why this doesn't inflate false positives",
				tldr: "The adjustment subtracts the same rule from every visitor regardless of arm, so it can't manufacture or hide a real difference.",
				body: "CUPED's adjustment, Y − θ(X − mean(X)), applies the identical rule to every visitor in both arms. Subtracting a quantity that doesn't depend on which arm a visitor was assigned to shifts both arms' means by the same expected amount (zero, in expectation), it cannot introduce a systematic difference between arms that wasn't already there. What it removes is variance correlated with X, which is exactly why the false-positive rate stays at its nominal level (see Key Findings) while the effect becomes easier to detect.",
			},
			{
				heading: "The repeated-trials speed study measures two different things on purpose",
				tldr: "\"Did a fixed final look detect it\" and \"how many days did it take to first cross significance\" are kept separate, one is safe to interpret as a false-positive rate, the other isn't.",
				body: "This page reports a final-day-only detection rate (a single, pre-committed look, exactly like The Peeking Problem's \"checked once\" bar) for the false-positive-rate claim, and, separately, a first-crossing day for the speed story. Conflating the two would silently reintroduce The Peeking Problem's own peeking inflation into a page that isn't about peeking at all, first-crossing search is itself a form of continuous monitoring. That distinction wasn't obvious until this page's own test suite caught it: an early version of the repeated-trials engine used first-crossing to compute the null false-positive rate too, and it came back at 25%, not 5%, exactly the kind of inflation the sibling project describes. The fix keeps the two questions, and the two decision rules behind them, separate.",
			},
			{
				heading: "What the published research says",
				tldr: "CUPED was published by Microsoft's experimentation team in 2013, and reported gains in production vary as widely as the correlation-driven simulation above predicts.",
				body: "CUPED (Controlled-experiment Using Pre-Experiment Data) was introduced by Deng, Xu, Kohavi and Walker in \"Improving the Sensitivity of Online Controlled Experiments by Utilizing Pre-Experiment Data\" (WSDM 2013), and the variance identity and unbiasedness argument used on this page follow that paper's construction. Production results depend heavily on the covariate. Microsoft's experimentation team reports gains as an \"effective traffic multiplier\", 1/(1 − R²), the reciprocal of this page's variance identity: on one product surface more than 55% of metrics got a multiplier above 1.2×, while on another surface of the same product more than 68% got 1.05× or less (Cosgrove, Townsend & Litz, \"Deep Dive Into Variance Reduction\", 2022). Netflix reported variance reductions of up to 40% for existing users on streaming metrics, with covariate correlations of only 0.2 to 0.4 for new users (Xie & Aurisset, KDD 2016).",
			},
			{
				heading: "A second kind of noise: outliers, not just variance",
				tldr: "Outlier handling needs a skewed metric to demonstrate, so those sections use a different generator from CUPED's.",
				body: "CUPED's simulation uses a correlated normal pair, which suits a linear covariate but has no meaningful outliers. The outlier sections simulate a zero-inflated, right-skewed revenue metric: 30% of visitors spend, and spenders draw from a log-normal with a $60 mean, the same model The Peeking Problem uses for revenue. The tail-concentrated scenario is calibrated (computeWhaleLiftMultiplier) to produce exactly the same total dollar lift as the uniform scenario, so the two differ only in where the effect lives, not in its size.",
			},
			{
				heading: "Pooled vs. stratified thresholds, run in parallel",
				tldr: "Each simulated day's data is analysed three ways at once: uncapped, capped at one threshold shared by both arms, and capped at each arm's own threshold.",
				body: "Pooled computes one percentile threshold from both arms' data combined and applies it to each arm. Stratified computes each arm's threshold from that arm's data alone. Both sound reasonable, and they fail in different ways: see Key Findings and the next section.",
			},
			{
				heading: "Why the stratified threshold inflates the false-positive rate",
				tldr: "A cap estimated from an arm's own data adds noise that the standard error does not count, and the size of that gap predicts the inflation almost exactly.",
				body: `Under the null both arms come from the same distribution, so a fixed cap applied to both could not create a difference. A stratified cap is not fixed: it is re-estimated from each arm's own data every day. An arm whose sample happens to include larger extremes gets a higher cap, so less of it is cut off and its capped mean rises, purely by chance. The usual standard error, computed from the capped values as if the cap were a known constant, leaves that source of variation out. The study measures the gap directly as the spread of the estimated difference across trials divided by the standard error each trial reported: ${x2(n99.raw.se_calibration)} for raw, ${x2(n99.pooled.se_calibration)} for pooled, ${x2(n99.stratified.se_calibration)} for stratified at the 99th percentile and ${x2(n90.stratified.se_calibration)} at the 90th. A test whose error bars are too narrow by that factor should reject a true null 2(1 − Φ(1.96 ÷ factor)) of the time, and those predictions (${p1(n99.stratified.implied_false_positive_rate)} and ${p1(n90.stratified.implied_false_positive_rate)}) fall inside the observed rates' 95% intervals. A pooled cap is estimated once from both arms, so its noise shifts both capped means together and cancels in the difference. This is the mechanism behind the standard advice to pre-register a winsorization threshold rather than estimate it from the data being tested.`,
			},
			{
				heading: "Where the outlier figures come from",
				tldr: `Every figure quoted in the text comes from a fixed-seed run of ${trials} experiments per scenario; the interactive study uses 300 and fresh noise each time.`,
				body: `The quoted figures are regenerated by scripts/the-noise-problem/build-outlier-findings.ts with the study section's own default settings (30% of visitors spend, $60 average spend, 50 visitors per arm per day, 20 days, 5% significance, top-5% whales for the tail scenario) and ${trials} trials per scenario under a fixed seed, and every rate carries a Wilson 95% interval. Pressing Run study repeats the same experiment with 300 trials and a new random seed, so its rates move by a point or two between runs; with 300 trials a true 5% rate lands anywhere from about 3% to 8%.`,
			},
		]}
	/>

	<Limitations
		items={[
			"This simulates a single continuous metric with a genuinely linear pre/post relationship at a known, fixed correlation. Real metrics can have a non-linear or heteroskedastic relationship to their pre-period value, where a linear CUPED adjustment captures less of the available variance reduction than the clean correlation number here implies.",
			"θ is re-estimated in-experiment, pooled across both arms, each simulated day, rather than fit once from a genuinely separate historical pre-experiment window, the more common production pattern. Re-estimating in-experiment is a reasonable simplification for this demo, not a difference that should matter much in practice, but it's a real design choice, not the only correct one.",
			"The core mechanic requires a pre-treatment covariate for every visitor. New visitors with no pre-period history, a very common case, get little or no benefit. Other techniques exist for that situation; When CUPED isn't the right tool covers them.",
			"This engine generates each simulated visitor individually rather than using the aggregate-sampling shortcuts The Peeking Problem's revenue mode needed for 500,000 visitors/day. Traffic here is capped in the low hundreds per day, plenty to see the real effect, not optimized for that scale.",
			"The outlier sections simulate one distribution (a zero-inflated log-normal) and one way an effect can concentrate in the tail. Real revenue distributions and real effects vary far more, so this shows one clear case of the trade-off rather than every form it takes.",
			"Real effects are not split cleanly into \"uniform\" and \"tail-concentrated\", and they are not calibrated to the same total lift. The calibration exists to make the comparison fair, not because real effects behave this way.",
			"The page lets you choose the cap percentile after seeing the scenario, which is the practice the outlier-handling literature warns against. In a real experiment the threshold should be fixed before looking at the data.",
		]}
	/>

	<NextSteps
		surprisingLabel="What was surprising"
		hardestLabel="Hardest part to get right"
		unresolvedLabel="What a proper fix would take"
		reflection={{
			surprising:
				"That the careful-sounding option breaks the test. Capping each arm at its own percentile feels like the safer choice, and it more than doubles the false-positive rate at the 99th percentile and roughly sextuples it at the 90th. The second surprise was how completely one number explains it: the ratio of each method's real spread to its reported standard error predicts the inflated rate to within a point. (The CUPED half of this page already learned a related lesson once, when a first-crossing search inflated its own false-positive rate; see Methodology.)",
			hardest:
				"Making the numbers reproducible. The first figures written down for the outlier results came from a run whose seed and trial count were never recorded, so nobody could check them. They are now regenerated from a fixed configuration by a script, read into the page at build time, and reported with intervals, and the regenerated values matched the originals to within a couple of points.",
			unresolved:
				"An analytic fix rather than a demonstration. The variance of a capped mean with an estimated cap has an extra term for the cap's own sampling noise, and that term depends on how thin the distribution is at the cap, which is hard to estimate from a heavy tail. A test using that corrected standard error, or simply a pre-registered fixed cap, would remove the inflation. Separately, CUPED's theta is still estimated in-experiment from both arms rather than from a separate historical window, the more common production pattern.",
		}}
	/>
</BaseLayout>
