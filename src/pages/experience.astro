---
import BaseLayout from "../layouts/BaseLayout.astro";

const timeline = [
	{ range: "2019 — Present", role: "Credit Karma / Intuit" },
	{ range: "2017 — 2019", role: "LendUp" },
	{ range: "2011 — 2017", role: "Finance & venture capital" },
	{ range: "2011", role: "B.A., Stanford University" },
];

const roles = [
	{
		range: "2019 — Present",
		title: "Staff Data Scientist",
		org: "Credit Karma / Intuit",
		bullets: [
			"Analytics owner of the experimentation program: defined the platform standards, guardrail metrics, and alerting, credited with saving roughly $200M/year in unnecessary losses.",
			"Currently leading a roadmap to move the org from frequentist to Bayesian experiment analysis.",
			"Designed a cross-functional engagement framework that became a companywide OKR for multiple years.",
			"Led the analytics org's push into AI: built internal tooling and automation, including the team's go-to AI-powered workflows.",
			"Mentored 8+ analysts.",
		],
	},
	{
		range: "2017 — 2019",
		title: "Senior Data Science Analyst",
		org: "LendUp",
		bullets: [
			"Built ML-driven credit policy models that increased loan approval rates by 12% with no meaningful effect on default rates.",
			"Built forecasting models that improved volume prediction accuracy by 20%.",
		],
	},
];
---

<BaseLayout
	title="Experience"
	description="Career history for Kyle DuPonte, Staff Data Scientist at Intuit, 14+ years across FinTech and finance, including 8+ in data science and analytics."
>
	<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28">
		<p class="font-mono text-xs uppercase tracking-widest text-accent-blue">Experience</p>
		<h1 class="font-display mt-2 text-4xl font-semibold tracking-tight md:text-6xl">Staff Data Scientist, Intuit</h1>
		<p class="mt-4 max-w-[60ch] text-lg text-ink-soft">
			14+ years across FinTech and finance, including 8+ in data science and product analytics.
		</p>

		<div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-[220px_1fr] md:gap-16">
			<div class="md:sticky md:top-28 md:self-start">
				<p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Timeline</p>
				<ul class="mt-4 space-y-4">
					{
						timeline.map((item) => (
							<li>
								<p class="font-mono text-xs text-accent-blue">{item.range}</p>
								<p class="text-sm text-ink">{item.role}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div class="max-w-[70ch] space-y-10">
				{
					roles.map((job) => (
						<div>
							<p class="font-mono text-xs uppercase tracking-widest text-ink-soft">{job.range}</p>
							<h2 class="font-display mt-1 text-xl font-semibold">
								{job.title} <span class="text-ink-soft">&middot; {job.org}</span>
							</h2>
							<ul class="mt-3 space-y-2 border-l border-line pl-5">
								{job.bullets.map((bullet) => (
									<li class="text-base leading-relaxed text-ink md:text-lg">{bullet}</li>
								))}
							</ul>
						</div>
					))
				}

				<div>
					<p class="font-mono text-xs uppercase tracking-widest text-ink-soft">2011 — 2017</p>
					<h2 class="font-display mt-1 text-xl font-semibold">Finance & venture capital</h2>
					<p class="mt-3 text-base leading-relaxed text-ink-soft md:text-lg">
						Earlier roles in venture capital and commercial banking, including data and performance tracking
						for a $1.2B VC/PE portfolio.
					</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase tracking-widest text-ink-soft">2011</p>
					<h2 class="font-display mt-1 text-xl font-semibold">B.A., Science, Technology & Society</h2>
					<p class="mt-3 text-base leading-relaxed text-ink-soft md:text-lg">Stanford University.</p>
				</div>
			</div>
		</div>

		<div class="mt-16 max-w-prose border border-line p-6">
			<p class="text-base text-ink">For my latest résumé, please reach out.</p>
			<a
				href="mailto:kduponte@gmail.com"
				class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent-blue px-6 py-3 text-sm font-medium text-paper transition-opacity hover:opacity-90"
			>
				Email me
			</a>
		</div>
	</div>
</BaseLayout>
