---
import Chip from "../Chip.astro";
import Ripples from "../Ripples.astro";
import { seedFrom } from "../../lib/patterns/ripples";

interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	summary: string;
	primaryCta?: { label: string; href: string };
	secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, subtitle, summary, primaryCta, secondaryCta } = Astro.props;

// A black hero with rain in the project's season color (BaseLayout sets the pair from the URL).
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
// Strip the legacy "[ ... ]" wrapping from eyebrow strings.
const eyebrowText = eyebrow?.replace(/^\[\s*|\s*\]$/g, "");
---

<header class="relative overflow-hidden border-b-[3px] border-black bg-black text-dark-ink" data-dark>
	<!-- Rain stays right of the headline, where the hero's visual slot sits. On phones, where the
	     text runs full width, it falls only in a square at the bottom, around the card and buttons. -->
	<div class="pointer-events-none absolute inset-x-0 bottom-0 aspect-square md:inset-0 md:aspect-auto" aria-hidden="true">
		<Ripples form="rain" seed={seedFrom(slug)} drops={5} minDist={240} areaX={[520, 960]} areaY={[150, 850]} class="text-ring-dark" />
	</div>
	<div class="halftone-light absolute inset-0 opacity-15" aria-hidden="true"></div>
	<div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 pb-14 pt-10 md:grid-cols-12 md:px-12 md:pb-20 md:pt-14">
		<div class="md:col-span-12">
			{
				eyebrowText && (
					<p class="font-mono inline-block -rotate-1 bg-dark-ink px-2.5 py-1 text-[11px] uppercase text-black">
						{eyebrowText}
					</p>
				)
			}
			<h1 class="mt-4 text-[clamp(3.5rem,13vw,11rem)] [text-wrap:balance]">{title}</h1>
		</div>
		<div class="md:col-span-7">
			{subtitle && <p class="text-2xl font-extrabold leading-tight md:text-3xl">{subtitle}</p>}
			<div class="mt-6 rounded-2xl border-[3px] border-black bg-paper p-6 text-ink">
				<p class="text-base font-medium leading-relaxed md:text-lg">{summary}</p>
			</div>
			{
				(primaryCta || secondaryCta) && (
					<div class="mt-8 flex flex-wrap items-center gap-4">
						{primaryCta && (
							<Chip as="a" href={primaryCta.href} interactive>
								{primaryCta.label}
							</Chip>
						)}
						{secondaryCta && (
							<Chip as="a" href={secondaryCta.href} interactive variant="ghost">
								{secondaryCta.label}
							</Chip>
						)}
					</div>
				)
			}
		</div>
		<!-- Reserved for a visual (e.g. the 3D truck) on the right half. -->
		<div class="md:col-span-5">
			<slot />
		</div>
	</div>
</header>
