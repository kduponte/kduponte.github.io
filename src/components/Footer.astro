---
import ContactStrip from "./ContactStrip.astro";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer>
	<ContactStrip />
	<div class="border-t border-line">
		<div class="mx-auto flex max-w-7xl flex-col-reverse items-center gap-4 px-6 py-8 text-xs text-ink-soft md:flex-row md:justify-between md:px-12">
			<p class="font-mono">© {year} Kyle DuPonte</p>
			<Logo variant="mark" class="h-5 w-5 opacity-60" />
		</div>
	</div>
</footer>
