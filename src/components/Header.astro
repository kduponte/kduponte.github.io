---
import Logo from "./Logo.astro";
import Ticker from "./Ticker.astro";

const navItems = [
	{ href: "/about", label: "About" },
	{ href: "/projects", label: "Projects" },
	{ href: "/experience", label: "Experience" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<Ticker />
<header class="relative z-50">
	<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-4 md:px-12">
		<a href="/" class="shrink-0" aria-label="Kyle DuPonte, home">
			<Logo variant="wordmark" />
		</a>
		<nav aria-label="Primary">
			<ul class="flex flex-wrap items-center gap-2 font-bold">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"raw-box raw-press shadow-hard-sm inline-block rounded-full px-4 py-1.5 text-sm text-black",
									isActive(item.href) ? "bg-lime" : "bg-cream",
								]}
							>
								{item.label.toLowerCase()}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
