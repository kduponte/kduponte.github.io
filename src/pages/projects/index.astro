---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Ripples from "../../components/Ripples.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { hasTilePreview, layoutTiles } from "../../lib/project-tiles";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const tilts = [-0.8, 0.6, 0.9, -0.5, 0.5, -0.9];
// Cards with a 3D preview take a two-row slot with the cards beside them stacked; the rest pair up.
const places = layoutTiles(projects.map((p) => hasTilePreview(p.id)));
---

<BaseLayout
	title="Projects"
	description="Portfolio projects from Kyle DuPonte: real, data-driven write-ups on experimentation, causal inference, and more."
>
	<!-- Every page opens on black with rain in its season color, kept right of the headline (on
	     phones, in a strip of its own under the headline). -->
	<div class="relative overflow-hidden border-b-[3px] border-black bg-black text-dark-ink" data-dark>
		<div class="pointer-events-none absolute inset-x-0 bottom-0 h-[50vw] md:inset-0 md:h-auto" aria-hidden="true">
			<Ripples form="rain" seed={1992} drops={4} minDist={220} scale={0.85} areaX={[730, 980]} areaY={[150, 850]} class="text-rain-dark" />
		</div>
		<div class="halftone-light absolute inset-0 opacity-15" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-6 pb-[50vw] pt-10 md:px-12 md:pb-16">
			<h1 class="text-[clamp(5rem,24vw,20rem)]">Projects</h1>
			<p class="mt-4 max-w-[48ch] text-lg font-bold leading-snug md:text-xl">
				Personal projects I build on my own time: real, data-driven write-ups on experimentation and causal
				inference, plus a couple of notes still in progress.
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-12">
			{
				projects.map((project, i) => (
					<ProjectCard
						slug={project.id}
						title={project.data.title}
						summary={project.data.summary}
						status={project.data.status}
						tags={project.data.tags}
						rotate={tilts[i % tilts.length]}
						place={places[i]}
					/>
				))
			}
		</div>
	</div>
</BaseLayout>
