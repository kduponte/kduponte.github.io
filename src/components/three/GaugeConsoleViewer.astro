---
/**
 * The Dashboard Problem's 3D hero: a 1980s instrument cluster with one center-zero gauge per
 * metric, driven by seeded runs of the page's own simulation at the live experiment's defaults.
 * Needles are z statistics, red zones are the chosen rule's redline, lamps light for flagged
 * metrics (lime: truly lifted; tomato: truly null). Tap (or Next) runs the next seed; the
 * correction switch moves the redline. The readout under the canvas spells out every number.
 *
 * With `readout={false}` it renders the canvas box alone (still tappable, draggable, with the
 * static fallback), transparent over whatever sits behind it, e.g. a project tile.
 */
import { CORRECTION_LABEL, describeRun, formatP, formatZ } from "../../lib/stats-sim/dashboard-readout";
import { CORRECTIONS, HERO_ALPHA, HERO_CONFIG, HERO_SEEDS, runGaugeDashboard, tallyRuns } from "../../lib/stats-sim/dashboard-runs";
import { FALLBACK_VIEWBOX, gaugeConsoleSvg } from "../../lib/three/gauge-console-fallback";
import { DEFAULT_CONSOLE_COLORS } from "../../lib/three/gauge-dial";

interface Props {
	/** Classes for the whole figure (canvas plus readout). */
	class?: string;
	/** Classes for the canvas box alone, e.g. negative margins to float it over a headline. */
	canvasClass?: string;
	/** Tailwind aspect-ratio classes for the canvas box. Defaults to 16:10. */
	aspect?: string;
	/** The readout card and caption under the canvas. False: the canvas alone. */
	readout?: boolean;
}

const { class: className = "", canvasClass = "", aspect = "aspect-[16/10]", readout = true } = Astro.props;

const runs = HERO_SEEDS.map((s) => runGaugeDashboard(s));
const first = runs[0];
const r0 = describeRun(first, "none", 0, runs.length);
const tally = tallyRuns(runs);
const nNull = first.metrics.filter((m) => m.is_null).length;
const nLift = first.metrics.length - nNull;
const lastNull = nNull;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const c = DEFAULT_CONSOLE_COLORS;

const ariaLabel = (sentence: string) =>
	`A 1980s instrument cluster with ${first.metrics.length} gauges, one per metric of a simulated dashboard. Each needle is a metric's z statistic; red zones at both ends mark the significance threshold. ${sentence} Drag to turn it; tap to run the next seed.`;
---

<figure data-gauge-console class:list={["relative w-full", className]}>
	<div
		data-gauge-console-viewer
		data-mode="none"
		role="img"
		aria-label={ariaLabel(r0.sentence)}
		class:list={["relative z-10 w-full select-none", aspect, canvasClass]}
	>
		<!-- Static fallback: the same run drawn flat. Shown until WebGL mounts, and kept if it can't. -->
		<svg data-fallback viewBox={FALLBACK_VIEWBOX} class="absolute inset-0 h-full w-full" aria-hidden="true" set:html={gaugeConsoleSvg(first, "none")} />
	</div>

	{readout && (
		<figcaption class="relative z-20 mt-2 w-full max-w-[28rem] md:ml-auto">
			<div class="raw-box rounded-2xl bg-cream p-4 text-black">
				<div class="flex items-center justify-between gap-3">
					<p class="font-mono text-[10px] uppercase leading-tight" data-g-eyebrow>{r0.eyebrow}</p>
					<button
						type="button"
						data-g-next
						class="font-mono raw-box shadow-hard-sm raw-press shrink-0 rounded-full bg-lime px-3 py-1 text-[10px] uppercase"
					>
						Next seed →
					</button>
				</div>

				<div class="mt-3 grid grid-cols-3 gap-1.5" role="group" aria-label="Decision rule">
					{
						CORRECTIONS.map((mode) => (
							<button
								type="button"
								data-g-mode={mode}
								aria-pressed={mode === "none" ? "true" : "false"}
								class="font-mono rounded-lg border-2 border-black px-1.5 py-1.5 text-[9px] uppercase leading-tight aria-pressed:bg-black aria-pressed:text-lime"
							>
								{CORRECTION_LABEL[mode]}
							</button>
						))
					}
				</div>

				<div class="mt-3 flex items-end justify-between gap-3" aria-live="polite">
					<p class="font-anton text-[1.9rem] leading-none"><span data-g-crossed>{r0.crossed.length}</span><span class="ml-1.5 text-base">in the red</span></p>
					<p class="font-anton text-right text-[1.9rem] leading-none">
						<span data-g-false>{r0.falseCount}</span><span class="ml-1.5 text-base" data-g-false-label>{r0.falseCount === 1 ? "false discovery" : "false discoveries"}</span>
					</p>
				</div>
				<p class="font-mono mt-2 text-[10px] uppercase leading-snug">Redline: <span data-g-redline>{r0.redline}</span></p>
				<p class="mt-1 text-[12px] font-medium leading-snug" data-g-rule>{r0.rule}</p>

				<ul class="mt-3 flex flex-wrap gap-1.5" data-g-list aria-label="Metrics in the red">
					{
						r0.crossed.map((m) => (
							<li class="font-mono flex items-center gap-1 rounded-md border-2 border-black bg-white px-1.5 py-0.5 text-[10px]">
								<span class="inline-block h-2 w-3 rounded-sm border border-black" style={`background:${m.is_null ? c.null : c.lift}`} />
								#{m.number} {m.is_null ? "null" : "lift"} z {formatZ(m.z)}
							</li>
						))
					}
				</ul>
				<p class="mt-2 text-[12px] font-medium leading-snug" data-g-missed>
					{r0.missed.length ? `Real lifts left out of the red: ${r0.missed.map((m) => `#${m.number} (z ${formatZ(m.z)})`).join(", ")}.` : "Every real lift is in the red."}
				</p>

				<details class="mt-3">
					<summary class="font-mono cursor-pointer text-[10px] uppercase">All {first.metrics.length} needles</summary>
					<table class="font-mono mt-2 w-full text-left text-[10px]">
						<thead>
							<tr class="border-b-2 border-black"><th class="py-0.5">#</th><th>Truth</th><th>A</th><th>B</th><th>z</th><th>p</th></tr>
						</thead>
						<tbody data-g-table>
							{
								first.metrics.map((m) => (
									<tr class="border-b border-black/20">
										<td class="py-0.5">{m.number}</td>
										<td>{m.is_null ? "null" : "lift"}</td>
										<td>{(m.rate_a * 100).toFixed(1)}%</td>
										<td>{(m.rate_b * 100).toFixed(1)}%</td>
										<td>{formatZ(m.z)}</td>
										<td>{formatP(m.p)}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</details>
			</div>
			<p class="mt-3 text-[11px] font-medium leading-snug">
				<strong>Every needle is real:</strong> one metric's two-proportion z statistic from this page's own simulation, at the live experiment's
				defaults: {first.metrics.length} metrics, {nNull} truly unchanged (#1–{lastNull}) and {nLift} truly lifted
				(+{pct(HERO_CONFIG.relative_lift)} on a {pct(HERO_CONFIG.baseline_rate)} baseline), {HERO_CONFIG.visitors_per_arm} visitors per arm, two-sided
				at α = {HERO_ALPHA}. Dials run from z −5 to +5, a tick per unit. Red zones: the rule's redline. Lamps: lit in the red, lime if the metric
				truly moved, tomato if it didn't. Seeds run 1 to {HERO_SEEDS.length} in order, none skipped; across all {tally.runs}, a truly unchanged metric
				reached the red in {tally.anyFalse.none} runs uncorrected, {tally.anyFalse.bonferroni} under Bonferroni and {tally.anyFalse.bh} under
				Benjamini-Hochberg. <strong>Not data:</strong> the needle swing, the sway and the blinking.
			</p>
		</figcaption>
	)}
</figure>

<script>
	import { mountViewers } from "../../scripts/three/viewer";
	import type { GaugeSelect, GaugeState } from "../../scripts/three/subjects/gauge-console";
	import { describeRun, formatP, formatZ } from "../../lib/stats-sim/dashboard-readout";
	import { HERO_SEEDS, runGaugeDashboard, type Correction } from "../../lib/stats-sim/dashboard-runs";
	import { DEFAULT_CONSOLE_COLORS } from "../../lib/three/gauge-dial";

	mountViewers("[data-gauge-console-viewer]", () => import("../../scripts/three/subjects/gauge-console").then((m) => m.default));

	const runs = HERO_SEEDS.map((s) => runGaugeDashboard(s));
	const intro = (host: HTMLElement) => (host.getAttribute("aria-label") ?? "").split(" Seed ")[0];
	const outro = " Drag to turn it; tap to run the next seed.";

	for (const fig of document.querySelectorAll<HTMLElement>("[data-gauge-console]")) {
		const host = fig.querySelector<HTMLElement>("[data-gauge-console-viewer]");
		if (!host) continue;
		const lead = intro(host);
		const el = (key: string) => fig.querySelector<HTMLElement>(`[data-g-${key}]`);
		const [eyebrow, crossed, falseN, falseLabel, redline, rule, list, missed, table] = [
			"eyebrow",
			"crossed",
			"false",
			"false-label",
			"redline",
			"rule",
			"list",
			"missed",
			"table",
		].map(el);
		const modeButtons = [...fig.querySelectorAll<HTMLButtonElement>("[data-g-mode]")];
		const hasReadout = !!eyebrow;

		let state: GaugeState = { index: 0, seed: runs[0].seed, mode: "none" };

		const show = (s: GaugeState) => {
			state = s;
			const run = runs[s.index];
			const r = describeRun(run, s.mode, s.index, runs.length);
			host.setAttribute("aria-label", `${lead} ${r.sentence[0].toUpperCase()}${r.sentence.slice(1)}${outro}`);
			host.dataset.mode = s.mode;
			if (!hasReadout) return;
			eyebrow!.textContent = r.eyebrow;
			crossed!.textContent = String(r.crossed.length);
			falseN!.textContent = String(r.falseCount);
			falseLabel!.textContent = r.falseCount === 1 ? "false discovery" : "false discoveries";
			redline!.textContent = r.redline;
			rule!.textContent = r.rule;
			list!.replaceChildren(
				...r.crossed.map((m) => {
					const li = document.createElement("li");
					li.className = "font-mono flex items-center gap-1 rounded-md border-2 border-black bg-white px-1.5 py-0.5 text-[10px]";
					const sw = document.createElement("span");
					sw.className = "inline-block h-2 w-3 rounded-sm border border-black";
					sw.style.background = m.is_null ? DEFAULT_CONSOLE_COLORS.null : DEFAULT_CONSOLE_COLORS.lift;
					li.append(sw, `#${m.number} ${m.is_null ? "null" : "lift"} z ${formatZ(m.z)}`);
					return li;
				}),
			);
			missed!.textContent = r.missed.length
				? `Real lifts left out of the red: ${r.missed.map((m) => `#${m.number} (z ${formatZ(m.z)})`).join(", ")}.`
				: "Every real lift is in the red.";
			table!.replaceChildren(
				...run.metrics.map((m) => {
					const tr = document.createElement("tr");
					tr.className = "border-b border-black/20";
					for (const [i, text] of [
						String(m.number),
						m.is_null ? "null" : "lift",
						`${(m.rate_a * 100).toFixed(1)}%`,
						`${(m.rate_b * 100).toFixed(1)}%`,
						formatZ(m.z),
						formatP(m.p),
					].entries()) {
						const td = document.createElement("td");
						if (i === 0) td.className = "py-0.5";
						td.textContent = text;
						tr.append(td);
					}
					return tr;
				}),
			);
			for (const b of modeButtons) b.setAttribute("aria-pressed", String(b.dataset.gMode === s.mode));
		};

		// Without WebGL nothing answers "gauges:select", so the readout redraws the flat fallback itself.
		const request = async (sel: GaugeSelect) => {
			if (host.querySelector("canvas")) {
				host.dispatchEvent(new CustomEvent<GaugeSelect>("gauges:select", { detail: sel }));
				return;
			}
			const next: GaugeState = {
				index: sel.index !== undefined ? ((sel.index % runs.length) + runs.length) % runs.length : state.index,
				seed: 0,
				mode: sel.mode ?? state.mode,
			};
			next.seed = runs[next.index].seed;
			const { gaugeConsoleSvg } = await import("../../lib/three/gauge-console-fallback");
			const svg = host.querySelector<SVGElement>("[data-fallback]");
			if (svg) svg.innerHTML = gaugeConsoleSvg(runs[next.index], next.mode);
			show(next);
		};

		host.addEventListener("gauges:state", (e) => show((e as CustomEvent<GaugeState>).detail));
		el("next")?.addEventListener("click", () => request({ index: state.index + 1 }));
		for (const b of modeButtons) b.addEventListener("click", () => request({ mode: b.dataset.gMode as Correction }));
	}
</script>
