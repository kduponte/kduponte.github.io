---
// A tilted round sticker: an outline in the current text color over the ground it sits on, so it
// reads as print, not as a button.
interface Props {
	/** Degrees of tilt. */
	rotate?: number;
	shape?: "circle" | "rect";
	class?: string;
}

const { rotate = 8, shape = "circle", class: className = "" } = Astro.props;
---

<div
	class:list={[
		"font-anton grid place-items-center border-[3px] border-current text-center uppercase leading-none",
		shape === "circle" ? "aspect-square rounded-full p-4" : "rounded-lg px-4 py-2",
		className,
	]}
	style={`transform: rotate(${rotate}deg)`}
>
	<span><slot /></span>
</div>
