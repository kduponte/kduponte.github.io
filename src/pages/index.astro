---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Sticker from "../components/Sticker.astro";
import Widget from "../components/Widget.astro";
import Chip from "../components/Chip.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Ripples from "../components/Ripples.astro";
import { hasTilePreview, layoutTiles } from "../lib/project-tiles";

const projects = (await getCollection("projects"))
	.filter((p) => p.data.status !== "coming-soon")
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

const log = (await getCollection("truckLog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = log[0];
const latestDate = latest?.data.date.toISOString().slice(0, 10);

// Asymmetric collage: cards with a 3D preview take a two-row slot (see layoutTiles), each card tilted.
const places = layoutTiles(projects.map((p) => hasTilePreview(p.id)));
const tilts = [-0.8, 1, 0.8, -0.5];
---

<BaseLayout
	title="Home"
	description="Kyle DuPonte, Staff Data Scientist. 10+ years in FinTech, working across full-stack analytics and experimentation."
>
	<!-- Black hero with grey rain: the home page wears no season pair, like Cav Empt's site at rest.
	     The project tiles below carry the color. -->
	<section class="relative overflow-hidden border-b-[3px] border-black bg-black text-dark-ink" data-dark>
		<Ripples form="rain" seed={1991} drops={7} minDist={210} class="text-rain-dark" />
		<div class="halftone-light absolute inset-0 opacity-15" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-6 pb-16 pt-10 md:px-12 md:pb-24 md:pt-14">
			<h1 class="text-[clamp(5.5rem,26vw,22rem)]">Kyle<br />DuPonte</h1>

			<div class="mt-8 grid grid-cols-1 items-start gap-8 md:grid-cols-12">
				<div class="rounded-2xl border-[3px] border-black bg-paper p-6 text-ink md:col-span-6">
					<p class="text-xl font-bold leading-snug md:text-2xl">
						Staff Data Scientist at Intuit. 10+ years in FinTech, working across full-stack analytics and
						<span class="chip-serif">experimentation</span>.
					</p>
					<div class="mt-5 flex flex-wrap items-center gap-2">
						<Chip>SF Bay Area</Chip>
						<Chip>Experimentation</Chip>
						<Chip as="a" href="/experience" interactive class="ml-auto">Experience →</Chip>
					</div>
				</div>

				{
					latest && (
						<Widget label="Now restoring" class="bg-black md:col-span-4 md:col-start-8">
							<p class="font-mono text-[11px] uppercase">Truck log · {latestDate}</p>
							<p class="mt-2 text-lg font-extrabold leading-tight">{latest.data.title}</p>
							<a href="/projects/the-22re-restoration" class="link mt-3 inline-block text-sm">
								Follow the build →
							</a>
						</Widget>
					)
				}
			</div>

			<Sticker rotate={12} class="absolute right-4 top-6 hidden w-28 bg-black text-sm md:grid lg:right-16 lg:w-36 lg:text-base">
				10+<br />years<br />in<br />FinTech
			</Sticker>
		</div>
	</section>

	<section class="bg-grey text-ink">
		<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<SectionHeading eyebrow="Projects" title="Portfolio, in progress." />
				<Chip as="a" href="/projects" interactive variant="ghost">View all →</Chip>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-12">
				{
					projects.map((project, i) => (
						<ProjectCard
							slug={project.id}
							title={project.data.title}
							summary={project.data.summary}
							status={project.data.status}
							tags={project.data.tags}
							rotate={tilts[i % tilts.length]}
							place={places[i]}
						/>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
