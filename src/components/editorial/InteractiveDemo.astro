---
interface Props {
	title: string;
	description?: string;
	id?: string;
}

const { title, description, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{title}</h2>
	{description && <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">{description}</p>}
	<div class="mt-8">
		<slot />
	</div>
</section>
