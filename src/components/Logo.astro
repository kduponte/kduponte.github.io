---
interface Props {
	variant?: "full" | "mark";
	class?: string;
}

const { variant = "mark", class: className = "" } = Astro.props;

const shapes = [
	{ accent: "var(--color-accent-blue)", polygon: "50,20 80,80 20,80" }, // triangle
	{ accent: "var(--color-accent-green)", polygon: "20,20 80,20 80,80 20,80" }, // square
	{
		accent: "var(--color-accent-yellow)",
		polygon: "84.64,50 67.32,80 32.68,80 15.36,50 32.68,20 67.32,20",
	}, // hexagon
];
---

{
	variant === "full" ? (
		<div class:list={["logo-row flex gap-8", className]} aria-hidden="true">
			{shapes.map((shape, i) => (
				<div class="logo-mark h-16 w-16 md:h-20 md:w-20" style={`animation-delay: ${i * 0.4}s`}>
					<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
						<circle cx="50" cy="50" r="45" fill="var(--color-paper)" class="logo-circle" />
						<polygon points={shape.polygon} fill={shape.accent} class="logo-polygon" />
						<rect x="0" y="45" width="100" height="10" fill="var(--color-ink)" class="logo-bar" />
					</svg>
				</div>
			))}
		</div>
	) : (
		<svg
			viewBox="0 0 100 100"
			preserveAspectRatio="xMidYMid meet"
			class:list={["logo-mark-static", className]}
			aria-hidden="true"
		>
			<circle cx="50" cy="50" r="45" fill="var(--color-ink)" />
			<polygon points="50,20 80,80 20,80" fill="var(--color-accent-blue)" />
			<rect x="0" y="45" width="100" height="10" fill="var(--color-paper)" class="logo-bar" />
		</svg>
	)
}

<style>
	.logo-mark svg {
		width: 100%;
		height: 100%;
	}

	.logo-bar {
		mix-blend-mode: difference;
	}

	.logo-mark .logo-circle {
		animation: logo-pulse 4s ease-in-out infinite;
		transform-origin: 50% 50%;
	}

	.logo-mark .logo-polygon {
		animation: logo-rotate 18s linear infinite;
		transform-origin: 50% 50%;
	}

	@keyframes logo-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(0.94);
		}
	}

	@keyframes logo-rotate {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-mark .logo-circle,
		.logo-mark .logo-polygon {
			animation: none;
		}
	}
</style>
