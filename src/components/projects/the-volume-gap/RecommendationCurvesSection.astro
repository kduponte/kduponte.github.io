---
import SensitivityExplorer from "./SensitivityExplorer.astro";
---

<section id="recommendation-curves" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">How recommendations change with weight and skill</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Each line traces one system's recommendation across the core weight range for a given skill level, against the
		dashed cross-system consensus curve. Toggle sources on or off to isolate one at a time.
	</p>

	<div id="vg-recommendation-curves" class="mt-8">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<label class="flex items-center gap-2 text-sm">
				<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">Skill</span>
				<select data-vg-skill-select class="border-2 border-black bg-paper px-3 py-1.5 text-ink">
					<option value="beginner">Beginner</option>
					<option value="intermediate" selected>Intermediate</option>
					<option value="advanced">Advanced</option>
				</select>
			</label>
			<button type="button" data-vg-table-toggle class="font-mono text-xs uppercase tracking-wide text-accent-blue" aria-pressed="false">
				View as table
			</button>
		</div>
		<div data-vg-source-toggles class="mt-4 flex flex-wrap gap-4"></div>
		<div data-vg-chart class="mt-4 overflow-x-auto"></div>
		<div data-vg-table class="mt-4 overflow-x-auto"></div>
	</div>

	<script src="../../../scripts/surf-volume/recommendation-curves-chart.ts"></script>

	<SensitivityExplorer />
</section>
