---
const links = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/kyleduponte/" },
	{ label: "GitHub", href: "https://github.com/kduponte" },
	{ label: "Email", href: "mailto:kduponte@gmail.com" },
];
---

<section class="border-t border-line bg-paper" aria-labelledby="contact-heading">
	<div class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
		<h2 id="contact-heading" class="font-display text-3xl font-semibold md:text-4xl">Get in touch</h2>
		<p class="mt-3 max-w-prose text-ink-soft">Always happy to connect. LinkedIn is the fastest way to reach me.</p>
		<ul class="mt-8 flex flex-wrap gap-3">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="tag-pill inline-flex items-center rounded-full border border-line px-4 py-2 text-xs uppercase tracking-wide text-ink transition-colors hover:border-accent-blue hover:text-accent-blue"
							target={link.href.startsWith("http") ? "_blank" : undefined}
							rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
						>
							[ {link.label} ]
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
