---
interface Section {
	heading: string;
	body: string;
	tldr?: string;
}

interface Props {
	title?: string;
	intro?: string;
	sections: Section[];
	id?: string;
}

const { title = "Methodology", intro, sections, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">{title}</h2>
	{intro && <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink">{intro}</p>}
	<div class="mt-8 space-y-8">
		{
			sections.map((section) => (
				<div class="max-w-[65ch] border-t-[3px] border-black pt-6">
					<h3 class="font-display text-xl font-extrabold">{section.heading}</h3>
					{section.tldr && <p class="mt-2 text-sm leading-relaxed font-semibold text-ink">{section.tldr}</p>}
					<p class="mt-2 text-sm leading-relaxed text-ink-soft">{section.body}</p>
				</div>
			))
		}
	</div>
</section>
