---
import FindingCard from "./FindingCard.astro";

interface Bar {
	label: string;
	value: number;
	unit?: string;
}

interface Finding {
	label: string;
	detail: string;
	bars?: Bar[];
}

interface Group {
	heading: string;
	description?: string;
	findings: Finding[];
}

interface Props {
	title?: string;
	lede?: string;
	findings?: Finding[];
	groups?: Group[];
}

const { title = "Key findings", lede, findings, groups } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">{title}</h2>
	{lede && <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink">{lede}</p>}
	{
		groups && groups.length > 0 ? (
			<div class="mt-8 space-y-10">
				{groups.map((group) => (
					<div>
						<h3 class="font-mono inline-block -rotate-1 bg-black px-2.5 py-1 text-[11px] uppercase text-lime">{group.heading}</h3>
						{group.description && <p class="mt-1 max-w-[65ch] text-sm text-ink-soft">{group.description}</p>}
						<ul class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2">
							{group.findings.map((finding) => (
								<FindingCard finding={finding} />
							))}
						</ul>
					</div>
				))}
			</div>
		) : (
			<ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
				{(findings ?? []).map((finding) => (
					<FindingCard finding={finding} />
				))}
			</ul>
		)
	}
</section>
