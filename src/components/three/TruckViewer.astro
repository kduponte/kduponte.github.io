---
interface Props {
	class?: string;
	/** Body color override for the 3D truck (any CSS hex color). Defaults to the model's red. */
	body?: string;
	/** Tailwind aspect-ratio class for the canvas box. */
	aspect?: string;
}

const { class: className = "", body, aspect = "aspect-[4/3]" } = Astro.props;
---

<div
	data-truck-viewer
	data-body={body}
	role="img"
	aria-label="A red 1991 Toyota pickup truck slowly rotating. Drag to spin it; tap to bounce it."
	class:list={["relative w-full select-none", aspect, className]}
>
	<!-- Static fallback: shown until WebGL mounts, and kept if it can't. -->
	<svg data-fallback viewBox="0 0 560 300" class="absolute inset-0 h-full w-full" aria-hidden="true">
		<g stroke="#111" stroke-width="6" stroke-linejoin="round">
			<rect x="30" y="150" width="300" height="70" fill="#c4262e" />
			<polygon points="170,150 190,90 260,90 300,150" fill="#8fd0ff" />
			<polygon points="170,150 330,150 330,110 520,125 535,215 170,215" fill="#c4262e" />
			<rect x="30" y="130" width="140" height="22" fill="#c4262e" />
			<circle cx="130" cy="225" r="42" fill="#111" />
			<circle cx="130" cy="225" r="17" fill="#c8ff3d" />
			<circle cx="440" cy="225" r="42" fill="#111" />
			<circle cx="440" cy="225" r="17" fill="#c8ff3d" />
			<circle cx="522" cy="165" r="10" fill="#ffd400" />
		</g>
	</svg>
</div>

<script>
	import { mountTruckViewers } from "../../scripts/three/truck";
	mountTruckViewers();
</script>
