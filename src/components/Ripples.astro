---
// Organic water ripples as a texture layer (see lib/patterns/ripples.ts). Color comes from the
// text color, so set it with a `text-*` class, e.g. "text-ring-paper". The strokes run through a
// blur-then-threshold filter, so strokes that sit close melt together into one solid shape, the
// way Cav Empt's ripples do. The result is solid color, never see-through.
import { formBlur, formPaths, type FormOptions, type RippleForm } from "../lib/patterns/ripples";

interface Props extends FormOptions {
	form?: RippleForm;
	class?: string;
}

const { class: className = "", form = "drop", ...opts } = Astro.props;
const paths = formPaths(form, opts);
const blur = formBlur(form, opts);
// Filter ids only need to be unique on a page; a counter across the build guarantees that.
const g = globalThis as { __rippleId?: number };
g.__rippleId = (g.__rippleId ?? 0) + 1;
const id = `ripple-goo-${g.__rippleId}`;
// Alpha above THRESHOLD becomes solid; the slope keeps a one-pixel-ish soft edge.
const SLOPE = 22;
const THRESHOLD = 0.45;
---

<svg
	class:list={["pointer-events-none absolute inset-0 h-full w-full", className]}
	viewBox="0 0 1000 1000"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
>
	<defs>
		<filter id={id} filterUnits="userSpaceOnUse" x="-60" y="-60" width="1120" height="1120" color-interpolation-filters="sRGB">
			<feGaussianBlur stdDeviation={blur} />
			<feComponentTransfer>
				<feFuncA type="linear" slope={SLOPE} intercept={-SLOPE * THRESHOLD} />
			</feComponentTransfer>
		</filter>
	</defs>
	<g filter={`url(#${id})`} fill="none" stroke="currentColor" stroke-linecap="round">
		{
			paths.map((p) =>
				p.fill ? <path d={p.d} fill="currentColor" stroke="none" /> : <path d={p.d} stroke-width={p.width} />,
			)
		}
	</g>
</svg>
