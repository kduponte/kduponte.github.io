---
import ContactStrip from "./ContactStrip.astro";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer>
	<ContactStrip />
	<div class="border-t-[3px] border-black bg-black text-cream">
		<div class="mx-auto flex max-w-7xl flex-col-reverse items-center gap-4 px-6 py-6 text-xs md:flex-row md:justify-between md:px-12">
			<p class="font-mono uppercase">© {year} Kyle DuPonte · Hilo / Bay Area</p>
			<Logo variant="mark" class="h-8 w-8" />
		</div>
	</div>
</footer>
