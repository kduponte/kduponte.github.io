---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagPill from "../../components/TagPill.astro";

export async function getStaticPaths() {
	// Projects with their own dedicated static route (richer than this generic markdown template
	// can express) — every entry here must be excluded from this dynamic route, or the build
	// collides with the dedicated page at the same path. Every future entry in the
	// interactive-explainer series joins this set. Declared inside getStaticPaths itself: Astro
	// extracts this function into an isolated build chunk that doesn't reliably capture
	// module-scope consts declared outside it.
	const dedicatedRouteSlugs = new Set(["the-volume-gap", "the-peeking-problem", "the-noise-problem", "the-dashboard-problem"]);
	const projects = (await getCollection("projects")).filter((project) => !dedicatedRouteSlugs.has(project.id));
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
	<article class="mx-auto max-w-3xl px-6 py-20 md:px-12 md:py-28">
		<a href="/projects" class="font-mono text-xs uppercase tracking-wide text-accent-blue">← All projects</a>
		<h1 class="font-display mt-6 text-4xl font-semibold tracking-tight md:text-5xl">{project.data.title}</h1>
		<p class="mt-4 text-lg text-ink-soft">{project.data.summary}</p>
		<ul class="mt-6 flex flex-wrap gap-2">
			{project.data.tags.map((tag: string) => <TagPill tone="blue">{tag}</TagPill>)}
		</ul>
		<div class="mt-12 max-w-[65ch] space-y-4 leading-relaxed text-ink">
			<Content />
		</div>
	</article>
</BaseLayout>
