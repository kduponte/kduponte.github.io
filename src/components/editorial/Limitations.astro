---
// Limitations as "the fine print" on a dark band: numbered, in readable type, so the caveats are
// part of the design instead of a grey afterthought.
import Band from "./Band.astro";

interface Props {
	title?: string;
	items: string[];
}

const { title = "Limitations", items } = Astro.props;
---

<section class="my-16 md:my-20">
	<Band tone="ink" cx={120} cy={140}>
		<div class="grid grid-cols-1 gap-10 md:grid-cols-12">
			<div class="md:col-span-4">
				<p class="font-mono inline-block -rotate-1 bg-dark-ink px-2.5 py-1 text-[11px] uppercase text-black">The fine print</p>
				<h2 class="font-anton mt-5 text-6xl leading-[0.9] md:text-7xl">{title}</h2>
			</div>
			<ol class="md:col-span-8">
				{
					items.map((item, i) => (
						<li class="grid grid-cols-[3rem_1fr] gap-3 border-t-2 border-current py-4 first:border-t-0 first:pt-0">
							<span class="font-anton text-3xl leading-none">{String(i + 1).padStart(2, "0")}</span>
							<span class="text-[16px] font-medium leading-relaxed">{item}</span>
						</li>
					))
				}
			</ol>
		</div>
	</Band>
</section>
