---
interface Bar {
	label: string;
	value: number;
	unit?: string;
}

interface Finding {
	label: string;
	detail: string;
	bars?: Bar[];
}

interface Props {
	finding: Finding;
}

const { finding } = Astro.props;

const bars =
	finding.bars && finding.bars.length > 0
		? (() => {
				const max = Math.max(...finding.bars!.map((b) => b.value), 1e-9);
				return finding.bars!.map((b) => ({ ...b, pct: Math.max(2, Math.min(100, (b.value / max) * 100)) }));
			})()
		: null;
---

<li class="raw-box shadow-hard rounded-2xl bg-cream p-6">
	<p class="font-display text-xl font-extrabold">{finding.label}</p>
	{
		bars && (
			<div class="mt-3 space-y-1.5">
				{bars.map((bar) => (
					<div class="flex items-center gap-2 font-mono text-xs">
						<span class="w-32 shrink-0 truncate text-ink-soft">{bar.label}</span>
						<span class="h-2 flex-1 border border-black bg-black/10">
							<span class="block h-2 bg-cobalt" style={`width: ${bar.pct}%`} />
						</span>
						<span class="w-14 shrink-0 text-right text-ink">
							{bar.value}
							{bar.unit ?? "%"}
						</span>
					</div>
				))}
			</div>
		)
	}
	<p class="mt-2 text-sm leading-relaxed text-ink-soft">{finding.detail}</p>
</li>
