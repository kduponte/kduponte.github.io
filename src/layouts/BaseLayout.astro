---
import "@fontsource/anton";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/silkscreen";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { seasonFor, themeFor } from "../lib/project-theme";

interface Props {
	title: string;
	description: string;
	/** Which season pair the page wears (lib/project-theme.ts). Project pages find theirs from the
	 * URL; pages without one (home, the projects index) keep tonal grey ripples. */
	season?: string;
}

const { title, description, season } = Astro.props;
const projectSlug = Astro.url.pathname.match(/^\/projects\/([^/]+)\/?$/)?.[1];
const pair = seasonFor(season ?? projectSlug ?? "");
const seasonVars = pair ? themeFor(pair).vars : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Kyle DuPonte",
	url: "https://kyleduponte.com",
	jobTitle: "Staff Data Scientist",
	worksFor: { "@type": "Organization", name: "Intuit" },
	sameAs: ["https://www.linkedin.com/in/kyleduponte/", "https://github.com/kduponte"],
	knowsAbout: [
		"Data Science",
		"Experimentation",
		"A/B Testing",
		"Causal Inference",
		"Machine Learning",
		"FinTech",
		"Data Engineering",
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />

		<title>{title} · Kyle DuPonte</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} · Kyle DuPonte`} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} · Kyle DuPonte`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
	</head>
	<body class="flex min-h-dvh flex-col bg-paper text-ink" data-season={pair?.id} style={seasonVars}>
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<script>
			import "../scripts/shared/figures";
		</script>
	</body>
</html>
