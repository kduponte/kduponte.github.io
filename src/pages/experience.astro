---
import BaseLayout from "../layouts/BaseLayout.astro";

const timeline = [
	{ range: "2019 — Present", role: "Credit Karma / Intuit" },
	{ range: "2017 — 2019", role: "LendUp" },
	{ range: "2011 — 2017", role: "Finance & venture capital" },
	{ range: "2011", role: "B.A., Stanford University" },
];

const roles = [
	{
		range: "2019 — Present",
		title: "Staff Data Scientist",
		org: "Credit Karma / Intuit",
		bullets: [
			"Analytics owner of the experimentation program: defined the platform standards, guardrail metrics, and alerting, credited with saving roughly $200M/year in unnecessary losses.",
			"Currently leading a roadmap to move the org from frequentist to Bayesian experiment analysis.",
			"Designed a cross-functional engagement framework that became a companywide OKR for multiple years.",
			"Led the analytics org's push into AI: built internal tooling and automation, including the team's go-to AI-powered workflows.",
			"Mentored 8+ analysts.",
		],
	},
	{
		range: "2017 — 2019",
		title: "Senior Data Science Analyst",
		org: "LendUp",
		bullets: [
			"Built ML-driven credit policy models that increased loan approval rates by 12% with no meaningful effect on default rates.",
			"Built forecasting models that improved volume prediction accuracy by 20%.",
		],
	},
];
---

<BaseLayout
	title="Experience"
	theme="lime"
	description="Career history for Kyle DuPonte, Staff Data Scientist at Intuit, 14+ years across FinTech and finance, including 8+ in data science and analytics."
>
	<div class="relative overflow-hidden border-y-[3px] border-black">
		<div class="halftone absolute inset-0 opacity-20" style="--dot: #2438ff; --cell: 14px" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-6 pb-12 pt-10 md:px-12 md:pb-16">
			<h1 class="text-[clamp(4rem,15vw,12rem)]">Experience</h1>
			<p class="mt-4 max-w-[60ch] text-lg font-bold md:text-xl">
				Staff Data Scientist, Intuit. 14+ years across FinTech and finance, including 8+ in data science and
				product analytics.
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
		<div class="grid grid-cols-1 gap-12 md:grid-cols-[220px_1fr] md:gap-16">
			<div class="md:sticky md:top-28 md:self-start">
				<p class="font-mono inline-block -rotate-1 bg-black px-2.5 py-1 text-[11px] uppercase text-lime">Timeline</p>
				<ul class="mt-4 space-y-4">
					{
						timeline.map((item) => (
							<li>
								<p class="font-mono text-xs text-cobalt">{item.range}</p>
								<p class="text-sm font-bold">{item.role}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div class="max-w-[70ch] space-y-10">
				{
					roles.map((job) => (
						<div>
							<p class="font-mono text-xs uppercase">{job.range}</p>
							<h2 class="mt-1 text-2xl font-extrabold">
								{job.title} <span class="text-cobalt">&middot; {job.org}</span>
							</h2>
							<ul class="mt-3 space-y-2 border-l-[3px] border-black pl-5">
								{job.bullets.map((bullet) => (
									<li class="text-base font-medium leading-relaxed md:text-lg">{bullet}</li>
								))}
							</ul>
						</div>
					))
				}

				<div>
					<p class="font-mono text-xs uppercase">2011 — 2017</p>
					<h2 class="mt-1 text-2xl font-extrabold">Finance & venture capital</h2>
					<p class="mt-3 text-base font-medium leading-relaxed md:text-lg">
						Earlier roles in venture capital and commercial banking, including data and performance tracking
						for a $1.2B VC/PE portfolio.
					</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase">2011</p>
					<h2 class="mt-1 text-2xl font-extrabold">B.A., Science, Technology & Society</h2>
					<p class="mt-3 text-base font-medium leading-relaxed md:text-lg">Stanford University.</p>
				</div>
			</div>
		</div>

		<div class="raw-box shadow-hard-lg mt-16 max-w-prose rounded-2xl bg-cream p-6 text-black">
			<p class="text-base text-ink">For my latest résumé, please reach out.</p>
			<a
				href="mailto:kduponte@gmail.com"
				class="raw-box raw-press shadow-hard-sm font-mono mt-6 inline-flex items-center gap-2 rounded-full bg-cobalt px-6 py-3 text-xs uppercase text-cream"
			>
				Email me
			</a>
		</div>
	</div>
</BaseLayout>
