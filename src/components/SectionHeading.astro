---
interface Props {
	eyebrow?: string;
	title: string;
	class?: string;
}

const { eyebrow, title, class: className = "" } = Astro.props;
---

<div class:list={["max-w-3xl", className]}>
	{
		eyebrow && (
			<p class="font-mono inline-block -rotate-1 bg-black px-2.5 py-1 text-[11px] uppercase text-lime">{eyebrow}</p>
		)
	}
	<h2 class="font-anton mt-3 text-4xl leading-[0.95] md:text-6xl">{title}</h2>
</div>
