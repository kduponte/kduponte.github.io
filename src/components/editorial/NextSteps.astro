---
interface Reflection {
	surprising: string;
	hardest: string;
	unresolved: string;
}

interface Props {
	title?: string;
	reflection?: Reflection;
	nextSteps: string[];
	surprisingLabel?: string;
	hardestLabel?: string;
	unresolvedLabel?: string;
}

const {
	title = "Reflection & next steps",
	reflection,
	nextSteps,
	surprisingLabel = "What was surprising",
	hardestLabel = "Easiest vs. hardest to compare",
	unresolvedLabel = "What real surfer outcomes would take",
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-28">
	<h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{title}</h2>
	{
		reflection && (
			<dl class="mt-8 grid max-w-[65ch] grid-cols-1 gap-6">
				<div>
					<dt class="font-mono text-xs uppercase tracking-wide text-accent-blue">{surprisingLabel}</dt>
					<dd class="mt-1 text-sm leading-relaxed text-ink-soft">{reflection.surprising}</dd>
				</div>
				<div>
					<dt class="font-mono text-xs uppercase tracking-wide text-accent-blue">{hardestLabel}</dt>
					<dd class="mt-1 text-sm leading-relaxed text-ink-soft">{reflection.hardest}</dd>
				</div>
				<div>
					<dt class="font-mono text-xs uppercase tracking-wide text-accent-blue">{unresolvedLabel}</dt>
					<dd class="mt-1 text-sm leading-relaxed text-ink-soft">{reflection.unresolved}</dd>
				</div>
			</dl>
		)
	}
	<div class="mt-10 max-w-[65ch]">
		<p class="font-mono text-xs uppercase tracking-wide text-ink-soft">Next highest-value improvements</p>
		<ol class="mt-3 space-y-2">
			{
				nextSteps.map((step, i) => (
					<li class="flex gap-3 text-sm leading-relaxed text-ink">
						<span class="font-mono text-ink-soft">{i + 1}.</span>
						<span>{step}</span>
					</li>
				))
			}
		</ol>
	</div>
</section>
