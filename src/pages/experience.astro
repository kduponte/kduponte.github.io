---
import BaseLayout from "../layouts/BaseLayout.astro";

const timeline = [
	{ range: "2019 — Present", role: "Credit Karma / Intuit" },
	{ range: "2017 — 2019", role: "LendUp" },
	{ range: "2011 — 2017", role: "Finance & venture capital" },
	{ range: "2011", role: "B.A., Stanford University" },
];
---

<BaseLayout
	title="Experience"
	description="Career history for Kyle DuPonte, Staff Data Scientist at Intuit, 14+ years across FinTech and finance, including 8+ in data science and analytics."
>
	<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28">
		<p class="font-mono text-xs uppercase tracking-widest text-accent-blue">Experience</p>
		<h1 class="font-display mt-2 text-4xl font-semibold tracking-tight md:text-6xl">Staff Data Scientist, Intuit</h1>
		<p class="mt-4 max-w-[60ch] text-lg text-ink-soft">
			14+ years across FinTech and finance, including 8+ in data science and product analytics.
		</p>

		<div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-[220px_1fr] md:gap-16">
			<div class="md:sticky md:top-28 md:self-start">
				<p class="font-mono text-xs uppercase tracking-widest text-ink-soft">Timeline</p>
				<ul class="mt-4 space-y-4">
					{
						timeline.map((item) => (
							<li>
								<p class="font-mono text-xs text-accent-blue">{item.range}</p>
								<p class="text-sm text-ink">{item.role}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div class="max-w-[70ch] space-y-6 text-base leading-relaxed text-ink md:text-lg">
				<p>
					I'm the analytics owner of Credit Karma's experimentation program: I defined the platform standards,
					guardrail metrics, and alerting that govern how the whole org runs and trusts experiments, work
					credited with saving roughly $200M a year in unnecessary losses. More recently, I laid out a roadmap
					to uplevel that program further, moving us from frequentist to Bayesian methods for faster, more
					confident decisions. That effort is still in flight, but has already netted a conservative estimate
					of $20M a month in ongoing savings.
				</p>

				<p>
					I'm usually the primary analyst for leadership, regulator, and external requests, and I sit on the
					central analytics team helping guide company strategy. A cross-functional engagement framework I
					designed became a companywide OKR for multiple years, and several metrics I've defined are now core
					business metrics feeding multi-year OKRs and planning. I also lead a lot of the team's automation
					and tooling work, including our AI-powered internal workflows, and mentor analysts on my team and
					beyond, 8 and counting.
				</p>

				<p>
					Before Credit Karma, I was a Senior Data Science Analyst at LendUp, where I built ML-driven credit
					policy models that increased loan approval rates by 12% with no meaningful effect on default rates,
					and forecasting models that improved volume prediction accuracy by 20%.
				</p>

				<p class="text-ink-soft">
					Earlier in my career, I spent several years in venture capital and commercial banking, including
					data and performance tracking for a $1.2B VC/PE portfolio. I have a B.A. in Science, Technology,
					and Society from Stanford.
				</p>
			</div>
		</div>

		<div class="mt-16 max-w-prose border border-line p-6">
			<p class="text-base text-ink">For my latest résumé, please reach out.</p>
			<a
				href="mailto:kduponte@gmail.com"
				class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent-blue px-6 py-3 text-sm font-medium text-paper transition-opacity hover:opacity-90"
			>
				Email me
			</a>
		</div>
	</div>
</BaseLayout>
