---
import type { CollectionMethod } from "../../lib/surf-volume/types";

interface SourceEntry {
	name: string;
	url: string;
	collectedAt: string;
	method: CollectionMethod;
}

interface Props {
	title?: string;
	sources: SourceEntry[];
}

const { title = "Sources", sources } = Astro.props;

const METHOD_LABEL: Record<CollectionMethod, string> = {
	table_extraction: "Published table",
	browser_automation: "Automated collection",
	manual_entry: "Manual entry",
	derived_from_published_ratio: "Derived from published ratio",
	derived_from_published_formula: "Derived from published formula",
	community_heuristic: "Community heuristic",
	public_api: "Public API",
};
---

<section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<div class="font-mono flex items-center gap-3 border-b-[3px] border-black pb-2 text-[11px] uppercase">
		<span class="bg-black px-2 py-0.5 text-spot">Credits</span>
	</div>
	<h2 class="font-anton mt-8 text-6xl leading-[0.9] md:text-7xl">{title}</h2>
	<div class="raw-box shadow-hard-lg mt-10 overflow-x-auto rounded-2xl bg-cream">
		<table class="w-full border-collapse text-[15px]">
			<thead>
				<tr class="font-mono border-b-[3px] border-black bg-black text-left text-[10px] uppercase text-spot">
					<th class="px-4 py-3">Source</th>
					<th class="px-4 py-3">Collected</th>
					<th class="px-4 py-3">Method</th>
				</tr>
			</thead>
			<tbody>
				{
					sources.map((s) => (
						<tr class="border-b-2 border-black/80 last:border-b-0">
							<td class="px-4 py-3 font-semibold">
								<a href={s.url} class="underline decoration-2 underline-offset-2" target="_blank" rel="noopener noreferrer">
									{s.name}
								</a>
							</td>
							<td class="font-mono px-4 py-3 text-[11px] uppercase">{s.collectedAt}</td>
							<td class="px-4 py-3 font-medium">{METHOD_LABEL[s.method]}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>
