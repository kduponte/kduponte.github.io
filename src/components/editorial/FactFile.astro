---
// A Brutus-style memo boxout: a tabbed box of key facts with dotted leaders. Every row should be a
// fact stated elsewhere on the page or in its sources; this box only gathers them in one place.
import { toneClasses, type TileTone } from "../../lib/tile-tone";

interface Props {
	title?: string;
	rows: { k: string; v: string }[];
	note?: string;
	tone?: TileTone;
	class?: string;
}

const { title = "Fact file", rows, note, tone = "paper", class: className = "" } = Astro.props;
const t = toneClasses(tone, Astro.url.pathname);
---

<div class:list={["relative rounded-2xl border-[3px] border-black p-5 pt-7", t.surface, t.shadow, className]}>
	<span class:list={["font-mono absolute -top-px left-5 rounded-b-lg px-2.5 py-1 text-[10px] uppercase", t.tab]}>{title}</span>
	<dl class="space-y-2.5 text-sm">
		{
			rows.map((r) => (
				<div class="flex items-baseline gap-2">
					<dt class="font-mono shrink-0 text-[10px] uppercase">{r.k}</dt>
					<span class="min-w-4 flex-1 translate-y-[-3px] border-b-2 border-dotted border-current opacity-40" aria-hidden="true" />
					<dd class="max-w-[62%] text-right font-semibold leading-snug">{r.v}</dd>
				</div>
			))
		}
	</dl>
	{note && <p class="font-mono mt-4 border-t-2 border-current pt-3 text-[10px] uppercase leading-relaxed">{note}</p>}
</div>
