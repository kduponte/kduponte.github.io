---
// Markup + mount points only; all behavior lives in src/scripts/the-noise-problem/study-chart.ts.
---

<section id="speed-study" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">How much faster, really?</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Simulate hundreds of independent experiments at a given correlation and traffic level, and measure two separate
		things: whether a fixed, pre-planned final look finds a real effect (only meaningful when one exists), and, when
		it does, how many days it took to first become visible.
	</p>

	<form id="pp-study-controls" class="mt-8 grid grid-cols-2 gap-4 border border-line p-6 md:grid-cols-5">
		<label class="flex flex-col gap-1 text-sm">
			<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">Pre/post correlation</span>
			<input id="pp-study-correlation" type="range" min="0" max="0.95" step="0.05" class="accent-accent-blue w-full" />
			<span id="pp-study-correlation-value" class="font-mono text-xs text-ink-soft"></span>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">B's lift (points)</span>
			<input id="pp-study-lift" type="number" min="0" max="20" step="0.5" class="border border-line bg-paper px-3 py-2 text-ink" />
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">Visitors/day/arm</span>
			<input id="pp-study-visitors" type="number" min="5" max="500" step="5" class="border border-line bg-paper px-3 py-2 text-ink" />
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="font-mono text-xs uppercase tracking-wide text-ink-soft">Days per experiment</span>
			<input id="pp-study-days" type="number" min="5" max="60" step="1" class="border border-line bg-paper px-3 py-2 text-ink" />
		</label>
		<div class="flex items-end">
			<button
				type="button"
				id="pp-study-run-button"
				class="w-full border border-ink bg-ink px-5 py-2.5 font-mono text-xs uppercase tracking-wide text-paper transition-colors hover:border-accent-blue hover:bg-accent-blue"
			>
				Run speed study
			</button>
		</div>
	</form>

	<div id="pp-speed-study" class="mt-6">
		<div data-vg-summary class="border border-line p-4 font-mono text-sm"></div>
		<div class="mt-4 flex justify-end">
			<button type="button" data-vg-table-toggle class="font-mono text-xs uppercase tracking-wide text-accent-blue" aria-pressed="false">
				View as table
			</button>
		</div>
		<div data-vg-chart class="mt-2 grid grid-cols-1 gap-8 overflow-x-auto md:grid-cols-2"></div>
		<div data-vg-table class="mt-2 overflow-x-auto"></div>
	</div>

	<script src="../../../scripts/the-noise-problem/study-chart.ts"></script>
</section>
