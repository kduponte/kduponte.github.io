---
// The write-up's key findings as a spread in the project's own color: a big title, the lede, and
// numbered finding cards in paper on top, so the takeaways read as their own chapter.
import FindingCard from "./FindingCard.astro";
import Band from "./Band.astro";

interface Bar {
	label: string;
	value: number;
	unit?: string;
}

interface Finding {
	label: string;
	detail: string;
	bars?: Bar[];
}

interface Group {
	heading: string;
	description?: string;
	findings: Finding[];
}

interface Props {
	title?: string;
	lede?: string;
	findings?: Finding[];
	groups?: Group[];
}

const { title = "Key findings", lede, findings, groups } = Astro.props;
// One running number across groups, so finding 05 is the fifth on the page.
let n = 0;
const numbered = groups?.map((g) => ({ ...g, findings: g.findings.map((f) => ({ f, i: ++n })) }));
const flat = (findings ?? []).map((f, i) => ({ f, i: i + 1 }));
---

<section class="my-16 md:my-20">
	<Band tone="field" cx={110} cy={130} rings={9}>
		<div class="font-mono flex items-center gap-3 border-b-[3px] border-current pb-2 text-[11px] uppercase">
			<span class="bg-black px-2 py-0.5 text-spot">The takeaways</span>
		</div>
		<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
			<h2 class="font-anton text-6xl leading-[0.9] md:col-span-5 md:text-8xl">{title}</h2>
			{lede && <p class="text-xl font-bold leading-snug md:col-span-7 md:text-2xl">{lede}</p>}
		</div>
		{
			numbered && numbered.length > 0 ? (
				<div class="mt-12 space-y-12">
					{numbered.map((group) => (
						<div>
							<h3 class="font-mono inline-block -rotate-1 bg-black px-2.5 py-1 text-[11px] uppercase text-spot">{group.heading}</h3>
							{group.description && <p class="mt-3 max-w-[65ch] text-base font-medium">{group.description}</p>}
							<ul class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
								{group.findings.map(({ f, i }) => (
									<FindingCard finding={f} index={i} />
								))}
							</ul>
						</div>
					))}
				</div>
			) : (
				<ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
					{flat.map(({ f, i }) => (
						<FindingCard finding={f} index={i} />
					))}
				</ul>
			)
		}
	</Band>
</section>
