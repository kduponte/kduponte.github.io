---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Résumé"
	description="Résumé for Kyle DuPonte, Staff Data Scientist at Intuit — FinTech, experimentation, and causal inference."
>
	<div class="mx-auto max-w-4xl px-6 py-20 md:px-12 md:py-28">
		<p class="font-mono text-xs uppercase tracking-widest text-accent-blue">Résumé</p>
		<h1 class="font-display mt-2 text-4xl font-semibold tracking-tight md:text-6xl">Staff Data Scientist, Intuit</h1>
		<p class="mt-4 max-w-[60ch] text-lg text-ink-soft">
			Full-stack data scientist with a background in FinTech experimentation and causal inference.
		</p>
		<p class="mt-4 font-mono text-xs uppercase tracking-wide text-ink-soft">[ PDF, updated 2026 ]</p>

		<a
			href="/resume.pdf"
			download="kyle-duponte-resume.pdf"
			class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent-blue px-6 py-3 text-sm font-medium text-paper transition-opacity hover:opacity-90"
		>
			Download PDF
		</a>

		<div class="mt-12 hidden overflow-hidden rounded border border-line md:block">
			<iframe src="/resume.pdf" title="Kyle DuPonte résumé" class="h-[1100px] w-full"></iframe>
		</div>
	</div>
</BaseLayout>
