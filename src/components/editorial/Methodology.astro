---
interface Section {
	heading: string;
	body: string;
}

interface Props {
	title?: string;
	sections: Section[];
	id?: string;
}

const { title = "Methodology", sections, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{title}</h2>
	<div class="mt-8 space-y-8">
		{
			sections.map((section) => (
				<div class="max-w-[65ch] border-t border-line pt-6">
					<h3 class="font-display text-lg font-semibold">{section.heading}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-soft">{section.body}</p>
				</div>
			))
		}
	</div>
</section>
