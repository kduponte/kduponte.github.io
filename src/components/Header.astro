---
import Logo from "./Logo.astro";
import Ticker from "./Ticker.astro";

const navItems = [
	{ href: "/about", label: "About" },
	{ href: "/projects", label: "Projects" },
	{ href: "/experience", label: "Experience" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<Ticker />
<header class="relative z-50 border-b-[3px] border-black bg-paper text-ink">
	<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-2 px-6 py-3 md:px-12">
		<a href="/" class="group shrink-0" aria-label="Kyle DuPonte, home">
			<Logo variant="wordmark" />
		</a>
		<nav aria-label="Primary" class="order-last w-full md:order-none md:mr-auto md:w-auto">
			<ul class="flex flex-wrap items-center gap-1">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"font-mono inline-block rounded-full border-2 px-3 py-1.5 text-[11px] uppercase transition-colors",
									isActive(item.href)
										? "border-black bg-pop text-pop-ink"
										: "border-transparent hover:border-black",
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a href="#contact" class="btn btn-sm ml-auto md:ml-0">Get in touch</a>
	</div>
</header>
