---
// A small pill. Interactive chips are buttons (safety orange, or a ghost outline that fills orange
// on hover); plain chips are outlined labels, never filled, so a label never looks clickable.
interface Props {
	as?: "span" | "a" | "button";
	/** For interactive chips: the orange button or the outline. */
	variant?: "primary" | "ghost";
	interactive?: boolean;
	class?: string;
	[attr: string]: unknown;
}

const { as: Tag = "span", variant = "primary", interactive = false, class: className = "", ...attrs } = Astro.props;
---

<Tag
	class:list={[interactive ? ["btn btn-sm", variant === "ghost" && "btn-ghost"] : "label-chip", className]}
	{...attrs}
>
	<slot />
</Tag>
