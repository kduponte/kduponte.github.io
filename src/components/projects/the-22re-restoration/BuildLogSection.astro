---
import { getCollection } from "astro:content";
import { chronological, totalCost, totalHours } from "../../../lib/truck-log/aggregate";

const SYSTEM_LABELS: Record<string, string> = {
	story: "The story",
	fuel: "Fuel system",
	engine: "Engine",
	cooling: "Cooling",
	electrical: "Electrical",
	brakes: "Brakes",
	suspension: "Suspension",
	transmission: "Transmission",
	body: "Body / rust",
	interior: "Interior",
	other: "Other",
};

const entries = await getCollection("truckLog");
const mapped = entries.map((entry) => ({
	date: entry.data.date,
	title: entry.data.title,
	system: entry.data.system,
	parts: entry.data.parts,
	hours: entry.data.hours,
	people: entry.data.people,
}));
const ordered = chronological(mapped);
const repairSessions = mapped.filter((entry) => entry.system !== "story");
const cost = totalCost(mapped);
const hours = totalHours(mapped);

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
}

function formatCurrency(value: number): string {
	return `$${value.toFixed(0)}`;
}
---

<section id="build-log" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">The build log</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Every session, logged as it actually happens: what we did, what it cost, how long it took, who was there.
		Nothing here is backfilled, this is just getting started.
	</p>

	<div class="mt-6 raw-box rounded-xl bg-cream p-4 font-mono text-sm">
		<span class="font-display text-2xl text-ink">{formatCurrency(cost)}</span>
		<span class="ml-2 text-sm text-ink-soft">spent so far &middot; {hours} hours logged &middot; {repairSessions.length} repair sessions</span>
	</div>

	<ol class="mt-8 space-y-6">
		{
			ordered.map((entry) => (
				<li class="raw-box rounded-xl bg-cream p-6">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<p class="font-display text-lg font-semibold">{entry.title}</p>
						<span class="font-mono text-xs uppercase tracking-wide text-accent-blue">{SYSTEM_LABELS[entry.system] ?? entry.system}</span>
					</div>
					<p class="mt-1 font-mono text-xs text-ink-soft">
						{formatDate(entry.date)}
						{entry.hours > 0 && ` · ${entry.hours} hour${entry.hours === 1 ? "" : "s"}`}
						{entry.people.length > 0 && ` · ${entry.people.join(", ")}`}
					</p>
					{entry.parts.length > 0 && (
						<ul class="mt-3 space-y-1 text-sm text-ink-soft">
							{entry.parts.map((part) => (
								<li class="flex justify-between">
									<span>{part.name}</span>
									<span class="font-mono">{formatCurrency(part.cost)}</span>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ol>
</section>
