---
interface Term {
	name: string;
	plain: string;
	technical: string;
}

const terms: Term[] = [
	{
		name: "False positive",
		plain: "Concluding B is actually better than A when, in truth, they're exactly the same, you just happened to see unlucky data.",
		technical:
			"Rejecting the null hypothesis, or crossing a Bayesian decision threshold, when the null is actually true. The nominal rate tested against throughout this page is 5%.",
	},
	{
		name: "p-value (the frequentist number)",
		plain: "A roundabout question: if A and B were truly identical, how surprising would data like this be? Small means surprising, treated as evidence something's really different. It is not the probability that B is actually better, that's a common misreading.",
		technical:
			"P(data at least this extreme | the null hypothesis is true), computed here from a two-proportion or two-sample z-test recomputed on the cumulative data each simulated day.",
	},
	{
		name: "Posterior probability (the Bayesian number)",
		plain: "A direct probability that B is actually better than A, given the data seen so far and a starting assumption about how likely that was before looking. This is the number people actually want when they ask a p-value's question.",
		technical:
			"P(rate_B > rate_A | data, prior), estimated here by Monte Carlo sampling from each arm's posterior distribution (Beta-Binomial, or Beta × Normal-Normal for a revenue metric).",
	},
	{
		name: "Bayes factor",
		plain: "A measure of how much the data moved your belief, not just where your belief ended up: the ratio of how likely the data is under \"something changed\" versus under \"nothing changed.\" That distinction is what the rest of this page turns on.",
		technical:
			"The likelihood ratio of the observed data under a mixture of alternative effect sizes versus under the null. Unlike a raw posterior probability, it's constructed to be a martingale under the null, see \"Can you actually peek safely?\" below.",
	},
	{
		name: "Peeking",
		plain: "Checking your results early and often, and being willing to act the moment they look convincing, instead of waiting for one look at a pre-planned end date.",
		technical:
			"Optional stopping: a decision rule whose stopping time depends on the data itself rather than being fixed in advance, which invalidates the usual guarantees behind a single-look p-value or a naive posterior threshold.",
	},
];
---

<section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">Before we start: five terms this page leans on</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Everything below uses these five words a lot. Each one gets a plain-language sentence first, that's the whole idea if
		you only want the whole idea, and a more precise technical line underneath it for anyone who wants the exact
		definition.
	</p>
	<dl class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
		{
			terms.map((term) => (
				<div class="raw-box rounded-xl bg-cream p-6">
					<dt class="font-display text-lg font-semibold">{term.name}</dt>
					<dd class="mt-2 text-sm leading-relaxed font-semibold text-ink">{term.plain}</dd>
					<div class="mt-3 border-t border-line pt-3">
						<p class="font-mono text-xs uppercase tracking-wide text-accent-blue">More precisely</p>
						<dd class="mt-1 text-xs leading-relaxed text-ink-soft">{term.technical}</dd>
					</div>
				</div>
			))
		}
	</dl>
	<p class="mt-6 max-w-[65ch] text-sm leading-relaxed text-ink-soft">
		The rest of this page is about what checking early does to each of these numbers, and whether there's a way to
		check early safely.
	</p>
</section>
