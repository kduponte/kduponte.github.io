---
import { getCollection, render } from "astro:content";

const entries = await getCollection("truckLog");
const storyEntry = entries.find((entry) => entry.data.system === "story");
const rendered = storyEntry ? await render(storyEntry) : null;
const Content = rendered?.Content;
---

<section id="the-story" class="mx-auto max-w-4xl px-6 py-20 md:px-12 md:py-28">
	<h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">{storyEntry?.data.title ?? "The story"}</h2>
	<div class="font-display mt-8 max-w-[65ch] space-y-6 font-medium text-lg leading-relaxed text-ink md:text-xl">{Content && <Content />}</div>
</section>
