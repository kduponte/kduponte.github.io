---
import Chip from "./Chip.astro";

interface Props {
	tone?: "blue" | "green" | "yellow" | "neutral";
	class?: string;
}

const { tone = "neutral", class: className = "" } = Astro.props;

// Legacy tone names map onto the new palette.
const chipTone = { blue: "cobalt", green: "lime", yellow: "sun", neutral: "cream" } as const;
---

<Chip tone={chipTone[tone]} class:list={["tag-pill", className]}><slot /></Chip>
