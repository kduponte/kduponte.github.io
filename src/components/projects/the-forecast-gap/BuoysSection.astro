---
// "The twelve buoys": what each instrument behind the results is, where it sits and what it
// recorded, with all twelve drawn at true size in one 3D view. One buoy's details show at a time,
// beside the view: pick a name under the view (its rows are the view's rows) or tap the view to step
// on, and that buoy's lantern lights and a ring marks it. Every figure comes from the frozen data:
// the NDBC station pages (buoy-stations.json), the coverage and per-station error tables, and the
// break registry.
import pages from "../../../../public/data/surf-forecast/buoy-stations.json";
import coverage from "../../../../public/data/surf-forecast/coverage.json";
import stationRows from "../../../../public/data/surf-forecast/stations.json";
import metadata from "../../../../public/data/surf-forecast/metadata.json";
import {
	PROFILE_LEAD_DAYS,
	buoyProfiles,
	countWord,
	hullLabel,
	operatorLabel,
	type ErrorRow,
	type ProfilePage,
} from "../../../lib/surf-forecast/buoy-profiles";
import { REGION_LABEL } from "../../../lib/surf-forecast/spots";
import { ft } from "../../../lib/surf-forecast/findings";
import { FLEET_GAP_M, FLEET_SCALE_STEP_M, buildBuoyFleet, type FleetStation } from "../../../lib/three/buoy-fleet";
import { frameAspect } from "../../../lib/three/buoy-diorama";
import { fleetFallbackSvg } from "../../../lib/three/buoy-fallback";
import { WAVERIDER_DIAMETER_M } from "../../../lib/three/buoy-model";
import { REPRESENTATIVE, SYSTEM_COLOR, SYSTEM_ORDER, SYSTEM_SHORT } from "../../../scripts/surf-forecast/palette";

const profiles = buoyProfiles({
	pages: pages.stations as ProfilePage[],
	coverage: coverage.rows,
	errors: stationRows.rows as ErrorRow[],
	representative: REPRESENTATIVE,
	systems: SYSTEM_ORDER,
});
const n = profiles.length;
const fleetStations: FleetStation[] = profiles.map(({ station, name, region, instrument, longitude }) => ({ station, name, region, instrument, longitude }));

// The box shape, the fallback lineup and the picker's rows, all from the same fleet the browser builds.
const probe = buildBuoyFleet(fleetStations);
const boxAspect = Math.round(frameAspect(probe.framing) * 100) / 100;
const blockDepth = probe.blockDepth;
const rows = probe.layout.rows.map((r) => ({ region: r.region, indices: [...r.indices] }));
const fallback = fleetFallbackSvg(
	profiles.map((p, i) => ({ instrument: p.instrument, reach: probe.reach[i], region: p.region })),
	{ tallest: Math.max(...probe.models.map((m) => m.height_m)), blockDepth, gap: FLEET_GAP_M, aspect: boxAspect },
);
probe.dispose();

// Prose figures.
const waveriders = profiles.filter((p) => p.instrument === "waverider");
const other = profiles.find((p) => p.instrument !== "waverider");
if (!other) throw new Error("expected one non-Waverider buoy");
const pacioos = profiles.filter((p) => p.page.owner?.includes("PacIOOS"));
const viaScripps = profiles.filter((p) => p.page.data_from?.includes("Scripps"));
const withWind = profiles.filter((p) => p.page.anemometer_height_m !== null);
const byDepth = [...profiles].filter((p) => p.page.water_depth_m !== null).sort((a, b) => a.page.water_depth_m! - b.page.water_depth_m!);
const shallow = byDepth[0];
const deep = byDepth[byDepth.length - 1];
const depthText = (m: number) => `${Math.round(m).toLocaleString("en-US")} m`;
const fetched = [...new Set(profiles.map((p) => p.page.fetched))].sort().join(", ");

// One scale for every mean-miss bar, so bars compare across buoys as well as systems.
const maxMiss = Math.max(...profiles.flatMap((p) => p.errors.map((e) => e.mae_m ?? 0)));
const months = profiles[0].record.months.map((m) => m.month);
const MONTH = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthShort = (ym: string) => MONTH[Number(ym.slice(5, 7)) - 1];
const monthName = (ym: string) => `${monthShort(ym)} ${ym.slice(0, 4)}`;
const span = `${monthShort(months[0])}–${monthName(months[months.length - 1])}`;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const coord = (lat: number, lon: number) => `${Math.abs(lat).toFixed(3)}° ${lat >= 0 ? "N" : "S"}, ${Math.abs(lon).toFixed(3)}° ${lon >= 0 ? "E" : "W"}`;

const hullText = (p: (typeof profiles)[number]) =>
	p.instrument === "waverider" ? `${hullLabel(p.page.hull)}, a ${WAVERIDER_DIAMETER_M} m sphere` : hullLabel(p.page.hull);
const sensorText = (pg: ProfilePage) =>
	[
		pg.anemometer_height_m !== null && `anemometers ${pg.anemometer_height_m} m up`,
		pg.air_temp_height_m !== null && `air temperature ${pg.air_temp_height_m} m up`,
		pg.sea_temp_depth_m !== null && `sea temperature ${pg.sea_temp_depth_m} m down`,
	]
		.filter(Boolean)
		.join(", ");
const breakList = (p: (typeof profiles)[number], claim: boolean) =>
	p.breaks.filter((b) => (b.tier !== "disagreement_only") === claim).map((b) => `${b.name} (${b.distance_km} km)`);
const panelId = (p: (typeof profiles)[number]) => `buoy-${p.station}`;
const payload = JSON.stringify({ stations: fleetStations }).replace(/</g, "\\u003c");

const rowText = rows
	.map((r, i) => `${i === 0 ? "the row of" : "the"} ${countWord(r.indices.length)} ${i === 0 ? "is" : "are"} ${REGION_LABEL[r.region]}${r.region === other.region ? `, with ${other.name}` : ""}`)
	.join("; ");
const label = `${countWord(n, true)} wave buoys at true size on a slowly turning block of still water: ${countWord(waveriders.length)} yellow Waverider spheres and ${other.name}'s larger ${hullLabel(other.page.hull)} with its tower. Drag to spin it; tap it for the next buoy.`;
---

<section id="buoys" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">The {countWord(n)} buoys</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Every accuracy figure above is a comparison with one of these {countWord(n)} instruments. {countWord(waveriders.length, true)} are
		Datawell Waverider buoys, {WAVERIDER_DIAMETER_M} m spheres that ride the surface and record its motion; the {countWord(pacioos.length)} in Hawaii
		belong to the {pacioos[0]?.page.owner}, and {viaScripps.length === waveriders.length ? `all ${countWord(viaScripps.length)}` : countWord(viaScripps.length)} report
		through Scripps Institution of Oceanography under a Coastal Data Information Program (CDIP) number. The other, {other.name}, is a
		{" "}{other.page.owner} {hullLabel(other.page.hull)}, and {withWind.length === 1 ? "the only one with an anemometer" : `one of ${countWord(withWind.length)} with anemometers`}.
		They are moored in water from {depthText(shallow.page.water_depth_m!)} deep at {shallow.name} to {depthText(deep.page.water_depth_m!)} at {deep.name}.
	</p>

	<div
		data-fleet-root
		data-station="0"
		data-count={n}
		class="mt-10 grid gap-8 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-10 lg:gap-y-6"
	>
		<script is:inline type="application/json" data-fleet-data set:html={payload} />

		<div class="lg:col-span-7">
			<div data-fleet-viewer role="img" aria-label={label} class="relative w-full select-none" style={`aspect-ratio: ${boxAspect}`}>
				<!-- Static fallback: shown until WebGL mounts, and kept if it can't. The same lineup, side on. -->
				<svg data-fallback viewBox={fallback.viewBox} class="absolute inset-0 h-full w-full" aria-hidden="true">
					<Fragment set:html={fallback.svg} />
				</svg>
			</div>

			<!-- The picker: one line per row of the view, back to front, each running west to east. -->
			<div class="mt-6 space-y-3" role="group" aria-label="Pick a buoy">
				{
					rows.map((row) => (
						<div class="sm:grid sm:grid-cols-[11rem_1fr] sm:items-baseline sm:gap-3">
							<p class="font-mono text-xs uppercase">{REGION_LABEL[row.region]}</p>
							<div class="mt-1.5 flex flex-wrap gap-2 sm:mt-0">
								{row.indices.map((i) => (
									<button
										type="button"
										data-fleet-pick={i}
										aria-pressed={i === 0 ? "true" : "false"}
										aria-controls={panelId(profiles[i])}
										class="border-2 border-black bg-cream px-3 py-1.5 text-sm leading-tight font-medium text-black transition-colors hover:bg-black/10 aria-pressed:bg-lime"
									>
										{profiles[i].name}
									</button>
								))}
							</div>
						</div>
					))
				}
			</div>
			<p data-fleet-live class="sr-only" aria-live="polite"></p>
		</div>

		<div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
			<div data-fleet-panels>
				{
					profiles.map((p, i) => (
						<article
							id={panelId(p)}
							data-fleet-panel={i}
							data-selected={i === 0 ? "" : undefined}
							class="group raw-box shadow-hard-sm overflow-hidden rounded-xl bg-cream text-black"
						>
							<header class="border-b-[3px] border-black px-5 py-4 group-data-[selected]:bg-lime">
								<p class="font-mono text-xs uppercase">
									{p.station}
									{p.page.cdip && ` · CDIP ${p.page.cdip}`} · {REGION_LABEL[p.region]}
								</p>
								<h3 class="font-display mt-1 text-2xl leading-tight font-semibold">{p.name}</h3>
							</header>

							<div class="space-y-6 px-5 py-5">
								<dl class="grid grid-cols-[5.5rem_1fr] gap-x-4 gap-y-2 text-[15px] leading-snug">
									<dt class="font-mono text-xs leading-[1.4rem] uppercase">Hull</dt>
									<dd>{hullText(p)}</dd>
									<dt class="font-mono text-xs leading-[1.4rem] uppercase">Run by</dt>
									<dd>{operatorLabel(p.page)}</dd>
									<dt class="font-mono text-xs leading-[1.4rem] uppercase">Depth</dt>
									<dd>{p.page.water_depth_m === null ? "Not stated" : `${depthText(p.page.water_depth_m)} of water`}</dd>
									<dt class="font-mono text-xs leading-[1.4rem] uppercase">Position</dt>
									<dd>{coord(p.latitude, p.longitude)}</dd>
									{sensorText(p.page) && (
										<>
											<dt class="font-mono text-xs leading-[1.4rem] uppercase">Sensors</dt>
											<dd>{sensorText(p.page).replace(/^./, (c) => c.toUpperCase())}</dd>
										</>
									)}
								</dl>

								<div>
									<p class="font-mono text-xs uppercase">
										Wave record, {span}: {pct(p.record.share)} of hours
									</p>
									<div class="mt-2 flex items-end gap-1" role="img" aria-label={p.record.months.map((m) => `${monthName(m.month)} ${pct(m.share)}`).join(", ")}>
										{p.record.months.map((m) => (
											<span class="flex flex-1 flex-col items-center gap-1">
												<span class="flex h-8 w-full items-end border-b-2 border-black">
													<span class="w-full bg-black" style={`height:${(m.share * 100).toFixed(1)}%`} title={`${monthName(m.month)}: ${pct(m.share)}`} />
												</span>
												<span class="text-xs leading-none text-ink-soft">{monthShort(m.month)}</span>
											</span>
										))}
									</div>
								</div>

								<div>
									<p class="font-mono text-xs uppercase">Mean miss, {PROFILE_LEAD_DAYS} days out</p>
									<ul class="mt-2 space-y-2">
										{p.errors.map((e) => (
											<li class="grid grid-cols-[3.75rem_1fr_4rem] items-center gap-3">
												<span class="font-mono text-xs uppercase">{SYSTEM_SHORT[e.system]}</span>
												<span class="h-3 rounded-[2px] bg-black/10">
													{e.mae_m !== null && (
														<span
															class="block h-3 rounded-[2px] outline-2 outline-black"
															style={`width:${((e.mae_m / maxMiss) * 100).toFixed(1)}%;background:${SYSTEM_COLOR[e.system]}`}
														/>
													)}
												</span>
												<span class="text-right text-[15px] tabular-nums">{e.mae_m === null ? "—" : `${ft(e.mae_m)} ft`}</span>
											</li>
										))}
									</ul>
								</div>

								<div class="space-y-3 text-[15px] leading-snug">
									{breakList(p, true).length > 0 && (
										<div>
											<p class="font-mono text-xs uppercase">Results apply at</p>
											<p class="mt-1">{breakList(p, true).join(", ")}</p>
										</div>
									)}
									{breakList(p, false).length > 0 && (
										<div>
											<p class="font-mono text-xs uppercase">Nearest buoy, no accuracy claim</p>
											<p class="mt-1">{breakList(p, false).join(", ")}</p>
										</div>
									)}
									{p.note && <p>{p.note}</p>}
									<p>
										<a href={p.page.url} class="underline underline-offset-2" rel="noopener">
											NDBC station page for {p.station}
										</a>
									</p>
								</div>
							</div>
						</article>
					))
				}
			</div>
			<p class="mt-5 text-sm leading-relaxed text-ink-soft">
				Mean miss is each system's average wave height error at the buoy, {PROFILE_LEAD_DAYS} days out, over the hours the buoy reported
				({metadata.window.start} to {metadata.window.end}). Every buoy's bars share one scale, so they compare across buoys as well as systems.
				The record bars show each month's share of the analysis's {metadata.grid} hours with a wave height reading.
			</p>
		</div>

		<p class="text-sm leading-relaxed text-ink-soft lg:col-span-7 lg:row-start-2">
			All {countWord(n)} at true size and one scale, on a cut of still water {blockDepth.toFixed(1)} m deep: each hull floats at its own
			waterline, and the water is see-through so the part below it shows. Back to front, {rowText}; each row runs west to east, as the
			names above do. The steps along the plinth's front edge are {FLEET_SCALE_STEP_M} m. {other.name}'s anemometers stand
			{" "}{other.page.anemometer_height_m} m above the water and its air temperature sensor {other.page.air_temp_height_m} m, as its station page
			gives; NDBC publishes no drawing of its seal cage, so the cage is drawn as a plain ring of bars. Pick a name to light that buoy's
			lantern and ring it, or tap the view for the next. Station details are from NDBC's station pages as fetched on {fetched}, which
			describe each buoy as deployed then.
		</p>
	</div>
</section>

<style>
	/* Without script every buoy's details stack as a list. With it, they share one cell (so the
	   panel keeps the tallest buoy's height and nothing below it jumps) and only the pick shows. */
	[data-fleet-panels] {
		display: grid;
		gap: 1.5rem;
	}
	[data-fleet-root][data-ready] [data-fleet-panels] {
		gap: 0;
	}
	[data-fleet-root][data-ready] [data-fleet-panel] {
		grid-area: 1 / 1;
	}
	[data-fleet-root][data-ready] [data-fleet-panel]:not([data-selected]) {
		visibility: hidden;
	}
</style>

<script>
	import { mountViewers } from "../../../scripts/three/viewer";
	mountViewers("[data-fleet-viewer]", () => import("../../../scripts/three/subjects/buoy-fleet").then((m) => m.default));
</script>

<script>
	// The picker, the details and the 3D view select through events on the section's root. Only a
	// click (or Enter or Space on a name) or a tap on the view changes the pick; pointing and
	// scrolling never do.
	import { BUOY_SELECT, currentStation, selectStation, type BuoySelectDetail } from "../../../scripts/three/buoy-events";

	for (const root of document.querySelectorAll<HTMLElement>("[data-fleet-root]")) {
		const picks = [...root.querySelectorAll<HTMLButtonElement>("[data-fleet-pick]")];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-fleet-panel]")];
		const live = root.querySelector<HTMLElement>("[data-fleet-live]");
		root.toggleAttribute("data-ready", true);
		for (const b of picks) {
			const i = Number(b.dataset.fleetPick);
			b.addEventListener("click", () => {
				if (currentStation(root) !== i) selectStation(root, i);
			});
		}
		root.addEventListener(BUOY_SELECT, (e) => {
			const { index } = (e as CustomEvent<BuoySelectDetail>).detail;
			panels.forEach((p) => p.toggleAttribute("data-selected", Number(p.dataset.fleetPanel) === index));
			picks.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.fleetPick) === index)));
			const name = picks.find((b) => Number(b.dataset.fleetPick) === index)?.textContent?.trim();
			if (live && name) live.textContent = `Showing ${name}`;
		});
	}
</script>
