---
/**
 * The board rack at the end of the Volume Gap writeup: every iconic board from the hero, in a
 * 3D rack at true relative size, ordered by liters. Pick one to take it down, stretch it inside
 * its maker's own size range, and see the volume move and where it lands for your weight and
 * skill. Behavior: src/scripts/surf-volume/board-rack.ts; 3D: surfboard-rack.ts.
 */
import iconicData from "../../../../public/data/surf-volume/iconic_boards.json";
import summary from "../../../../public/data/surf-volume/profile_summary.json";
import { resolveBoards, type IconicBoardData } from "../../../lib/surf-volume/iconic-boards";
import type { ComparisonResult } from "../../../lib/surf-volume/types";
import type { RackViewerConfig } from "../../../scripts/three/subjects/surfboard-rack";

const data = iconicData as unknown as IconicBoardData;
const { consensus, rows } = summary as unknown as ComparisonResult;
// Ordered by the liters each board starts at, so the rack reads small to big.
const resolved = resolveBoards(data, consensus, rows).sort((a, b) => a.size.volume_l - b.size.volume_l);

const config: RackViewerConfig = {
	ink: "#111111",
	paper: "#f6f1e4",
	logos: data.logos,
	boards: resolved.map((r) => ({
		id: r.board.id,
		name: r.board.name,
		liters: r.size.volume_l,
		finish: r.board.finish,
		shapeSpec: r.board.shape,
		size: r.size,
		fins: r.board.shape.fin_layout,
		finSetup: r.board.fin_setup,
		graphic: r.board.graphic,
		colors: r.board.colors,
		labels: r.board.labels ?? [],
	})),
};
const order = resolved.map((r) => ({ id: r.board.id, start: r.size.length }));
const list = resolved.map((r) => ({ id: r.board.id, name: r.board.name, liters: r.size.volume_l }));
const SLIDERS = [
	{ key: "length", label: "Length" },
	{ key: "width", label: "Width" },
	{ key: "thickness", label: "Thickness" },
];
---

<section id="board-rack" class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-20">
	<h2 class="font-anton text-4xl md:text-5xl">Pull a board off the rack</h2>
	<p class="mt-3 max-w-[65ch] text-base leading-relaxed text-ink-soft">
		Every board from the top of the page, at true relative size and ordered by liters. Take one down, then stretch it within
		its maker's own size range and watch the volume move, and where it lands against what the calculators recommend for you.
	</p>

	<div data-board-rack data-order={JSON.stringify(order)} class="mt-8">
		<div
			data-volume-rack-viewer
			data-config={JSON.stringify(config)}
			role="img"
			aria-label={`A wooden surfboard rack holding ${list.length} boards at true relative size, smallest volume on the left: ${list.map((b) => `${b.name} (${b.liters} L)`).join(", ")}. Pick a board from the list below to take it down.`}
			class="raw-box relative aspect-[6/5] w-full select-none overflow-hidden rounded-xl bg-cream sm:aspect-[5/2]"
		>
			<!-- Static fallback: shown until WebGL mounts, and kept if it can't. -->
			<svg data-fallback viewBox="0 0 560 280" class="absolute inset-0 h-full w-full" aria-hidden="true">
				<g stroke="#111" stroke-width="4" stroke-linejoin="round">
					<rect x="30" y="236" width="500" height="14" fill="#c8925a" />
					<rect x="30" y="120" width="500" height="10" fill="#c8925a" />
					{
						list.map((b, i) => (
							<ellipse cx={58 + i * 49} cy={236 - 52 - b.liters * 0.9} rx="18" ry={52 + b.liters * 0.9} fill="#fbfaf5" />
						))
					}
				</g>
			</svg>
		</div>

		<ul data-rack-list class="mt-4 flex flex-wrap gap-2" aria-label="Boards in the rack, smallest volume first">
			{
				list.map((b) => (
					<li>
						<button
							type="button"
							data-rack-pick={b.id}
							aria-pressed="false"
							class="raw-box rounded-full bg-cream px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-lime aria-pressed:bg-lime data-[hover]:bg-lime/50"
						>
							{b.name}
							<span class="font-mono ml-1 text-[10px] uppercase text-ink-soft">{b.liters.toFixed(1)} L</span>
						</button>
					</li>
				))
			}
		</ul>

		<p data-rack-hint class="font-mono mt-3 text-xs uppercase text-ink-soft">Tap a board in the rack or pick one above.</p>

		<div data-rack-panel hidden class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="raw-box rounded-2xl bg-cream p-5">
				<div class="flex items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="font-mono text-[10px] uppercase leading-tight" data-p-eyebrow></p>
						<h3 class="font-anton mt-1 text-[2rem] leading-none" data-p-name></h3>
						<p class="mt-1 text-xs font-semibold" data-p-maker></p>
					</div>
					<button type="button" data-p-back class="font-mono raw-box shadow-hard-sm raw-press shrink-0 rounded-full bg-paper px-3 py-1 text-[10px] uppercase">
						Put it back
					</button>
				</div>

				<div class="mt-5 flex items-end justify-between gap-3 border-t-2 border-black pt-4">
					<p class="font-mono text-[10px] uppercase leading-snug">
						<span data-p-dims></span><br /><span data-p-method></span>
					</p>
					<p class="font-anton shrink-0 text-[2.4rem] leading-none"><span data-p-liters></span><span class="ml-1 text-lg">L</span></p>
				</div>

				<div class="mt-4 grid gap-4">
					{
						SLIDERS.map((s) => (
							<label class="block">
								<span class="font-mono flex justify-between text-[10px] uppercase">
									<span>{s.label}</span>
									<output data-p-out={s.key} class="text-sm font-bold normal-case" />
								</span>
								<input data-p-slider={s.key} type="range" step="any" class="mt-1 w-full accent-black" />
								<span class="font-mono flex justify-between text-[10px] text-ink-soft">
									<span data-p-min={s.key} />
									<span data-p-max={s.key} />
								</span>
							</label>
						))
					}
				</div>
				<p data-p-onesize hidden class="font-mono mt-2 text-[10px] uppercase text-ink-soft"></p>

				<div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-xs">
					<p><span class="font-semibold">Nearest stock size:</span> <span data-p-nearest></span></p>
					<button type="button" data-p-snap class="font-mono raw-box shadow-hard-sm raw-press rounded-full bg-lime px-3 py-1 text-[10px] uppercase">
						Snap to it
					</button>
				</div>
				<p class="mt-3 text-[11px] leading-snug text-ink-soft">
					Sliders stop at the smallest and largest of each dimension in the maker's own size chart. Volume between stock sizes
					is estimated the way the data file fills unpublished sizes: length × width × thickness × this model's median box fill.
					The 3D board is recalibrated to hold that volume as you drag. Its outline stretches with the width and length,
					while rocker, foil and rails stay the model's own.
				</p>
			</div>

			<div class="raw-box rounded-2xl bg-cream p-5">
				<p class="font-mono text-[10px] uppercase">Your fit</p>
				<div class="mt-2 grid grid-cols-2 gap-3">
					<label class="flex flex-col gap-1 text-sm">
						<span class="font-mono text-[10px] uppercase text-ink-soft">Weight (lb)</span>
						<input data-p-weight type="number" min="100" max="280" step="1" class="border-2 border-black bg-paper px-3 py-2 text-ink" />
					</label>
					<label class="flex flex-col gap-1 text-sm">
						<span class="font-mono text-[10px] uppercase text-ink-soft">Skill</span>
						<select data-p-skill class="border-2 border-black bg-paper px-3 py-2 text-ink">
							<option value="beginner">Beginner</option>
							<option value="intermediate">Intermediate</option>
							<option value="advanced">Advanced</option>
						</select>
					</label>
				</div>

				<p class="font-anton mt-5 text-[1.9rem] leading-none" data-p-headline aria-live="polite"></p>
				<p class="mt-2 text-sm leading-snug" data-p-sentence></p>
				<svg data-p-bar viewBox="-8 0 316 70" class="mt-4 w-full overflow-visible" aria-hidden="true"></svg>
				<p class="font-mono mt-1 text-[10px] uppercase text-ink-soft">
					Dots: each calculator's pick for you. Box: middle half. Line: median. Orange: this board.
				</p>
				<p class="mt-4 text-[11px] leading-snug text-ink-soft">
					Same comparison as the top of the page, recomputed for the weight and skill here (they follow the profile form above
					when you change it). "Too little" and "too much" mean outside every calculator's pick. None of these systems were
					validated against real surfing, and liters leave out everything in the section above.
				</p>
			</div>
		</div>
	</div>

	<script>
		import { mountViewers } from "../../../scripts/three/viewer";
		import { initBoardRack } from "../../../scripts/surf-volume/board-rack";

		mountViewers("[data-volume-rack-viewer]", () => import("../../../scripts/three/subjects/surfboard-rack").then((m) => m.default));
		for (const el of document.querySelectorAll<HTMLElement>("[data-board-rack]")) initBoardRack(el);
	</script>
</section>
