---
import Chip from "./Chip.astro";

const links = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/kyleduponte/" },
	{ label: "GitHub", href: "https://github.com/kduponte" },
	{ label: "Email", href: "mailto:kduponte@gmail.com" },
];
---

<section class="overflow-hidden border-t-[3px] border-black bg-lime text-black" aria-labelledby="contact-heading">
	<div class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
		<h2 id="contact-heading" class="font-anton text-[clamp(3.5rem,14vw,11rem)] leading-[0.85]">
			Get in <span class="chip-serif">touch</span>
		</h2>
		<p class="mt-6 max-w-prose font-medium">Always happy to connect. LinkedIn is the fastest way to reach me.</p>
		<ul class="mt-8 flex flex-wrap gap-4">
			{
				links.map((link) => (
					<li>
						<Chip
							as="a"
							href={link.href}
							tone="cream"
							interactive
							target={link.href.startsWith("http") ? "_blank" : undefined}
							rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
						>
							{link.label} ↗
						</Chip>
					</li>
				))
			}
		</ul>
	</div>
</section>
