---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
---

<BaseLayout
	title="Home"
	description="Kyle DuPonte, Staff Data Scientist. 10+ years in FinTech, working across full-stack analytics and experimentation."
>
	<section class="border-b border-line bg-ink text-paper">
		<div class="mx-auto flex min-h-[calc(100dvh-73px)] max-w-7xl flex-col justify-center px-6 py-24 md:px-12">
			<Logo variant="full" class="mb-12" />

			<h1 class="font-display max-w-3xl text-5xl font-semibold tracking-tight md:text-8xl">Kyle DuPonte</h1>
			<p class="mt-6 max-w-2xl text-lg text-paper/80 md:text-2xl">
				Staff Data Scientist at Intuit. 10+ years in FinTech, working across full-stack analytics and
				experimentation.
			</p>

			<ul class="mt-8 flex flex-wrap gap-3 font-mono text-xs uppercase tracking-wide text-paper/70">
				<li class="rounded-full border border-paper/30 px-3 py-1">[ SF Bay Area ]</li>
				<li class="rounded-full border border-paper/30 px-3 py-1">[ Experimentation ]</li>
			</ul>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href="/resume"
					class="rounded-full border border-paper px-6 py-3 text-sm font-medium transition-colors hover:bg-paper hover:text-ink"
				>
					View Résumé
				</a>
				<a
					href="#contact-heading"
					class="rounded-full border border-paper/40 px-6 py-3 text-sm font-medium text-paper/90 transition-colors hover:border-paper"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</section>

	<section class="border-b border-line">
		<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28">
			<SectionHeading eyebrow="About" title="Experimentation is the throughline." />
			<p class="mt-6 max-w-[65ch] text-base leading-relaxed text-ink-soft md:text-lg">
				I became the resident expert on Credit Karma's experimentation platform: the primary contributor to its
				codebase, and the person teams came to for statistical methodology. Lately I've been picking up causal
				inference too, for the questions a randomized test can't answer.
			</p>
			<a href="/about" class="mt-6 inline-block font-mono text-xs uppercase tracking-wide text-accent-blue"
				>Read the full story →</a
			>
		</div>
	</section>

	<section class="border-b border-line">
		<div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<SectionHeading eyebrow="Projects" title="Portfolio, in progress." />
				<a href="/projects" class="font-mono text-xs uppercase tracking-wide text-accent-blue">View all →</a>
			</div>
			<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
				{
					projects.map((project) => (
						<ProjectCard
							slug={project.id}
							title={project.data.title}
							summary={project.data.summary}
							status={project.data.status}
							tags={project.data.tags}
						/>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
