---
// The contact block: white, with a drizzle of small ripples in the page's season color. The
// buttons carry the only color, so the way to reach out is the loudest thing in it.
import Ripples from "./Ripples.astro";
import { seedFrom } from "../lib/patterns/ripples";

const links = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/kyleduponte/", primary: true },
	{ label: "GitHub", href: "https://github.com/kduponte" },
	{ label: "Email", href: "mailto:kduponte@gmail.com" },
];
---

<section id="contact" class="relative overflow-hidden border-t-[3px] border-black bg-paper text-ink" aria-labelledby="contact-heading">
	<Ripples form="drizzle" seed={seedFrom(Astro.url.pathname, 31)} class="text-ring-paper" />
	<div class="relative mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24">
		<h2 id="contact-heading" class="font-anton text-[clamp(3.5rem,14vw,11rem)] leading-[0.85]">
			Get in <span class="chip-serif">touch</span>
		</h2>
		<p class="mt-6 max-w-prose font-medium">Always happy to connect. LinkedIn is the fastest way to reach me.</p>
		<ul class="mt-8 flex flex-wrap gap-3">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class:list={["btn", !link.primary && "btn-ghost"]}
							target={link.href.startsWith("http") ? "_blank" : undefined}
							rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
						>
							{link.label} ↗
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
